            IntPtr hT = OpenThread(0x0040 /* THREAD_QUERY_INFORMATION */ | 0x0008 /* THREAD_GET_CONTEXT */, false, (uint)t.Id);
            if (hT == IntPtr.Zero) hT = OpenThread(0x0040, false, (uint)t.Id);
            if (hT != IntPtr.Zero) {
                IntPtr startAddr = IntPtr.Zero;
                int retLen;
                int status = NtQueryInformationThread(hT, 9 /* ThreadQuerySetWin32StartAddress */, out startAddr, IntPtr.Size, out retLen);
                if (status == 0 && startAddr != IntPtr.Zero) {
                    MEMORY_BASIC_INFORMATION mbi;
                    if (VirtualQueryEx(hProc, startAddr, out mbi, (uint)Marshal.SizeOf(typeof(MEMORY_BASIC_INFORMATION))) != 0) {
                        if (mbi.Type == 0x20000 /* MEM_PRIVATE */ && (mbi.Protect == 0x20 || mbi.Protect == 0x40 || mbi.Protect == 0x10 || mbi.Protect == 0x80)) {
                            alerts.Add("INJECTED_THREAD|TID:" + t.Id + "|0x" + startAddr.ToInt64().ToString("X") + "|MEM_PRIVATE|0x" + mbi.Protect.ToString("X"));
                        }
                    }
                }

                Marshal.WriteInt32(ctxBuf, 0x30, 0x00100010 /* CONTEXT_DEBUG_REGISTERS */);
                if (GetThreadContext(hT, ctxBuf)) {
                    ulong dr0 = (ulong)Marshal.ReadInt64(ctxBuf, 0x48);
                    ulong dr1 = (ulong)Marshal.ReadInt64(ctxBuf, 0x50);
                    ulong dr2 = (ulong)Marshal.ReadInt64(ctxBuf, 0x58);
                    ulong dr3 = (ulong)Marshal.ReadInt64(ctxBuf, 0x60);
                    ulong dr7 = (ulong)Marshal.ReadInt64(ctxBuf, 0x70);
                    if ((dr7 & 0xFF) != 0 || dr0 != 0 || dr1 != 0 || dr2 != 0 || dr3 != 0) {
                        alerts.Add("HW_BREAKPOINT|TID:" + t.Id + "|DR0:0x" + dr0.ToString("X") + "|DR1:0x" + dr1.ToString("X") + "|DR2:0x" + dr2.ToString("X") + "|DR3:0x" + dr3.ToString("X") + "|DR7:0x" + dr7.ToString("X"));
                    }
                }

                CloseHandle(hT);
            }
        }
    } finally {
        Marshal.FreeHGlobal(ctxBuf);
        CloseHandle(hProc);
    }
    return alerts.ToArray();
}
'@ -ErrorAction Stop
        return $true
    } catch {
        return $false
    }
}


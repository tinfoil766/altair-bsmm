function Resolve-ProcessIdentity {
    param([int]$TargetPid)

    try {
        $p = Get-CimInstance Win32_Process -Filter "ProcessId=$TargetPid" -ErrorAction Stop | Select-Object -First 1
        if ($p -and $p.Name) {
            $path = [string]$p.ExecutablePath
            if (-not $path -and ('ROR.ExternalScan' -as [type])) {
                try { $path = [ROR.ExternalScan]::GetNativeProcessPath($TargetPid) } catch {}
            }
            return @{ Name = [string]$p.Name; Path = $path }
        }
    } catch {}
    try {
        $p = Get-Process -Id $TargetPid -ErrorAction Stop
        $path = ''
        try { $path = [string]$p.Path } catch {}
        if (-not $path -and ('ROR.ExternalScan' -as [type])) {
            try { $path = [ROR.ExternalScan]::GetNativeProcessPath($TargetPid) } catch {}
        }
        return @{ Name = "$($p.ProcessName).exe"; Path = $path }
    } catch {}
    if ('ROR.ExternalScan' -as [type]) {
        try {
            $np = [ROR.ExternalScan]::GetNativeProcessPath($TargetPid)
            if ($np) {
                $leaf = [System.IO.Path]::GetFileName($np)
                return @{ Name = $leaf; Path = $np }
            }
        } catch {}
    }
    if ($path -and $path -match '^\\Device\\HarddiskVolume') { $dosPath = Resolve-VolumePathToDosPath $path; if ($dosPath) { $path = $dosPath } }
    return @{ Name = "PID $TargetPid"; Path = '' }
}

function Get-ProcessForensicDetails {
    param(
        [int]$TargetPid,
        [string]$NativePath = ''
    )

    $details = [ordered]@{
        Pid                = $TargetPid
        Name               = "PID $TargetPid"
        Path               = ''
        NativePath         = $NativePath
        IsUnpluggedUsb     = $false
        IsRemovableUsb     = $false
        UnpluggedVolume    = ''
        UnpluggedDesc      = ''
        CommandLine        = ''
        ParentPid          = 0
        ParentName         = ''
        Services           = @()
        ForeignModules     = @()
        UnsignedModules    = @()
        UnlinkedModules    = @()
        PrivateExecRegions = @()
        SignatureStatus    = 'Unknown'
        Signer             = ''
    }

    try { [ROR.ExternalScan]::EnableDebugPrivilege() } catch {}

    if (-not $details.NativePath -and ('ROR.ExternalScan' -as [type])) {
        try { $details.NativePath = [ROR.ExternalScan]::GetNativeProcessPath($TargetPid) } catch {}
    }

    try {
        $cimProc = Get-CimInstance Win32_Process -Filter "ProcessId=$TargetPid" -ErrorAction Stop | Select-Object -First 1
        if ($cimProc) {
            if ($cimProc.Name) { $details.Name = [string]$cimProc.Name }
            if ($cimProc.ExecutablePath) { $details.Path = [string]$cimProc.ExecutablePath }
            if ($cimProc.CommandLine) { $details.CommandLine = [string]$cimProc.CommandLine }
            if ($cimProc.ParentProcessId) {
                $details.ParentPid = [int]$cimProc.ParentProcessId
                try {
                    $pParent = Get-Process -Id $details.ParentPid -ErrorAction Stop
                    $details.ParentName = "$($pParent.ProcessName).exe"
                } catch {
                    $details.ParentName = "PID $($details.ParentPid)"
                }
            }
        }
    } catch {}

    if (-not $details.Path) {
        try {
            $p = Get-Process -Id $TargetPid -ErrorAction Stop
            if ($details.Name -eq "PID $TargetPid") { $details.Name = "$($p.ProcessName).exe" }
            $details.Path = [string]$p.Path
        } catch {}
    }

    # Analyze USB / Unplugged status from NativePath and Path
    $vMap = Get-MountedVolumeMap
    $histMap = Get-HistoricalVolumeMap

    if ($details.NativePath -match '^(\\Device\\HarddiskVolume\d+)\\(.+)$') {
        $vKey = $matches[1].ToLowerInvariant()
        $vRel = $matches[2]
        if ($vMap.ContainsKey($vKey)) {
            $mounted = $vMap[$vKey]
            if ($mounted.DriveType -eq 'Removable') {
                $details.IsRemovableUsb = $true
            }
            if (-not $details.Path) {
                $details.Path = Join-Path $mounted.Root $vRel
            }
        } else {
            # Volume is NOT currently mounted -> UNPLUGGED USB!
            $details.IsUnpluggedUsb = $true
            $details.UnpluggedVolume = $vKey
            if ($histMap.ContainsKey($vKey)) {
                $details.UnpluggedDesc = " [$($histMap[$vKey])]"
            }
            if (-not $details.Path) {
                $details.Path = $details.NativePath
            }
            $details.SignatureStatus = 'Unsigned / Disk Disconnected (USB Unplugged)'
        }
    }

    if ($details.Path -match '^([A-Za-z]:)\\' -and (-not $details.IsUnpluggedUsb)) {
        $driveRoot = "$($matches[1])\"
        if (-not (Test-Path -LiteralPath $driveRoot -ErrorAction SilentlyContinue)) {
            $details.IsUnpluggedUsb = $true
            $details.SignatureStatus = 'Unsigned / Disk Disconnected (USB Unplugged)'
        } else {
            try {
                $dInfo = [System.IO.DriveInfo]::new($driveRoot)
                if ($dInfo.DriveType -eq [System.IO.DriveType]::Removable) {
                    $details.IsRemovableUsb = $true
                }
            } catch {}
        }
    }

    if ($details.Name -eq "PID $TargetPid") {
        if ($details.Path) {
            $details.Name = [System.IO.Path]::GetFileName($details.Path)
        } elseif ($details.NativePath) {
            $details.Name = [System.IO.Path]::GetFileName($details.NativePath)
        }
    }

    try {
        $svcs = @(Get-CimInstance Win32_Service -Filter "ProcessId=$TargetPid" -ErrorAction Stop)
        foreach ($s in $svcs) {
            $details.Services += "$($s.Name) ($($s.DisplayName))"
        }
    } catch {}

    if ($details.Path -and (Test-Path -LiteralPath $details.Path)) {
        try {
            $sigInfo = Get-FileSignatureAssessment -Path $details.Path
            if ($sigInfo.IsSelfSigned) {
                $details.SignatureStatus = "Self-Signed ($($sigInfo.Status))"
            } elseif ($sigInfo.Status -eq 'Valid' -and -not $sigInfo.IsShippedRoot) {
                $details.SignatureStatus = "UntrustedRoot ($($sigInfo.Status))"
            } else {
                $details.SignatureStatus = [string]$sigInfo.Status
            }
            if ($sigInfo.Signer) { $details.Signer = $sigInfo.Signer }
        } catch {}
    }

    $mainExePath = [string]$details.Path
    $mainExeDir = if ($mainExePath) { [System.IO.Path]::GetDirectoryName($mainExePath) } else { '' }
    $procNameLower = ($details.Name -replace '\.exe$', '').ToLower()

    $pebModules = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
    $allModulePaths = New-Object 'System.Collections.Generic.List[string]'
    $seenModulePaths = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)

    try {
        $proc = Get-Process -Id $TargetPid -ErrorAction Stop
        foreach ($mod in $proc.Modules) {
            $modPath = [string]$mod.FileName
            if (-not [string]::IsNullOrWhiteSpace($modPath)) {
                [void]$pebModules.Add($modPath)
                if ($seenModulePaths.Add($modPath)) {
                    $allModulePaths.Add($modPath)
                }
            }
        }
    } catch {}

    $rawVad = @()
    try { $rawVad = @([ROR.ExternalScan]::ScanProcessVirtualMemory($TargetPid)) } catch {}
    $hasJitEngine = $false

    foreach ($entry in $rawVad) {
        if ($entry -like 'IMAGE|*') {
            $vadPath = $entry.Substring(6)
            if (-not [string]::IsNullOrWhiteSpace($vadPath)) {
                if ($seenModulePaths.Add($vadPath)) {
                    $allModulePaths.Add($vadPath)
                }
                # Check for module from unplugged USB volume
                if ($vadPath -match '^(\\Device\\HarddiskVolume\d+)\\' -and (-not $vMap.ContainsKey($matches[1].ToLowerInvariant()))) {
                    $details.ForeignModules += @{
                        Name   = [System.IO.Path]::GetFileName($vadPath)
                        Path   = $vadPath
                        Status = 'Unplugged USB / Disconnected Disk'
                        Signer = 'Unsigned'
                    }
                    $details.UnlinkedModules += "$vadPath (From UNPLUGGED USB Volume)"
                    $details.UnsignedModules += $vadPath
                    continue
                }
                # Check if DLL was unlinked from PEB (only when PEB was readable and it's a .dll outside Windows/app dir)
                if ($pebModules.Count -gt 0 -and (-not $pebModules.Contains($vadPath)) -and ($vadPath -match '(?i)\.dll$')) {
                    $isUnderWin = $vadPath.StartsWith($env:SystemRoot, [System.StringComparison]::OrdinalIgnoreCase)
                    $isSameAppDir = ($mainExeDir -and $vadPath.StartsWith($mainExeDir, [System.StringComparison]::OrdinalIgnoreCase))
                    $isDefDir = ($vadPath -like "$env:ProgramData\Microsoft\Windows Defender\Platform\*")
                    if ((-not $isUnderWin) -and (-not $isSameAppDir) -and (-not $isDefDir)) {
                        $vSig = $null
                        try { $vSig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $vadPath -ErrorAction Stop } catch {}
                        if ((-not $vSig) -or $vSig.Status -ne 'Valid' -or (Test-UserLandProcessPath -ExecutablePath $vadPath) -or (Get-MatchedCheatKeyword -Text $vadPath)) {
                            $details.UnlinkedModules += $vadPath
                        }
                    }
                }
            }
        } elseif ($entry -like 'ORPHANED_USB_IMAGE|*') {
            $details.IsUnpluggedUsb = $true
            $oParts = $entry -split '\|', 3
            $oAddr = if ($oParts.Count -ge 2) { $oParts[1] } else { 'Unknown' }
            $oSize = if ($oParts.Count -ge 3) { $oParts[2] } else { '0' }
            $details.UnlinkedModules += "Unbacked orphaned image from unplugged USB ($oAddr, $oSize bytes)"
            $details.UnsignedModules += "Unplugged USB Memory Image ($oAddr)"
        }
    }

    foreach ($modPath in $allModulePaths) {
        if ($modPath -match '(?i)\\(clr|coreclr|mscorwks|chakra|jscript9)\.dll$') {
            $hasJitEngine = $true
        }

        if (($mainExePath -and [string]::Equals($modPath, $mainExePath, [System.StringComparison]::OrdinalIgnoreCase)) -or
            ($modPath -match '(?i)\.exe$')) {
            continue
        }

        $modLeaf = [System.IO.Path]::GetFileName($modPath)
        if ($modLeaf -ieq [string]$details.Name) { continue }

        $isUnderWinDir = $modPath.StartsWith($env:SystemRoot, [System.StringComparison]::OrdinalIgnoreCase)
        $isDefenderDir = ($modPath -like "$env:ProgramData\Microsoft\Windows Defender\Platform\*" -or $modPath -like "$env:ProgramFiles\Windows Defender\*")

        $modSig = $null
        try { $modSig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $modPath -ErrorAction Stop } catch {}
        $status = if ($modSig) { [string]$modSig.Status } else { 'Unknown' }
        $subj = if ($modSig -and $modSig.SignerCertificate) { [string]$modSig.SignerCertificate.Subject } else { 'Unsigned' }
        $isMsSigned = ($status -eq 'Valid' -and ($subj -match 'Microsoft Windows|Microsoft Corporation'))
        $isRobloxSigned = ($status -eq 'Valid' -and ($subj -match 'Roblox Corporation'))

        if ((($isUnderWinDir -or $isDefenderDir) -and $isMsSigned) -or $isRobloxSigned) {
            continue
        }

        $isUserland = (Test-UserLandProcessPath -ExecutablePath $modPath)
        $hasModKw = [bool](Get-MatchedCheatKeyword -Text $modPath)

        # Any Authenticode-Valid module chained to a trusted shipped Root CA outside userland/temp with no cheat keywords is a legitimate vendor DLL
        if ((-not $isUserland) -and (-not $hasModKw) -and $status -eq 'Valid' -and ($isMsSigned -or (Test-SignedByShippedRoot -Path $modPath))) {
            continue
        }

        if ($procNameLower -in @('robloxplayerbeta', 'robloxcrashhandler', 'robloxplayerlauncher', 'bloxstrap', 'fishstrap', 'lunarstrap') -or $details.Name -match '(?i)roblox') {
            $isRobloxDir = ($mainExeDir -and $modPath.StartsWith($mainExeDir, [System.StringComparison]::OrdinalIgnoreCase))
            if ((-not $hasModKw) -and ($isRobloxSigned -or $isRobloxDir -or ($modPath -match '(?i)\\(Roblox|Bloxstrap|Fishstrap)\\Versions\\'))) {
                continue
            }
        }

        if ($status -ne 'Valid' -or $isUserland -or $hasModKw) {
            $details.ForeignModules += @{
                Name   = $modLeaf
                Path   = $modPath
                Status = $status
                Signer = $subj
            }
            if ($status -ne 'Valid') {
                $details.UnsignedModules += $modPath
            }
        }
    }

    foreach ($entry in $rawVad) {
        if ($entry -like 'PRIVEXEC|*') {
            $parts = $entry -split '\|', 5
            if ($parts.Count -ge 5) {
                $prot = $parts[1]
                $baseHex = $parts[2]
                $regSize = $parts[3]
                $tag = $parts[4]
                if ($tag -in @('MANUAL_MAP_PE', 'UNBACKED_RX_EXEC')) {
                    $details.PrivateExecRegions += "$tag ($prot at $baseHex, $regSize bytes)"
                } elseif ($tag -eq 'RWX_SHELLCODE' -and (-not $hasJitEngine)) {
                    $details.PrivateExecRegions += "$tag ($prot at $baseHex, $regSize bytes)"
                }
            }
        }
    }

    return $details
}


function Format-WindowCaptureExclusionAlert {
    param(
        [int]$ProcessId,
        [string]$WindowTitle = '',
        [string]$AffinityHex = '11',
        [string]$Visibility = 'Visible'
    )

    $diag = Get-ProcessForensicDetails -TargetPid $ProcessId
    $nameLower = ($diag.Name -replace '\.exe$', '').ToLower()

    if ($script:CaptureWindowAllowlist -contains $nameLower) { return $null }

    # Discord Overlay exemption if signed
    if ($nameLower -eq 'discord' -and ($WindowTitle -eq 'Discord Overlay' -or (-not $WindowTitle))) {
        if (($diag.Path -and $diag.Path -match '(?i)\\AppData\\Local\\Discord\\app-') -or ($diag.Signer -match '(?i)Discord') -or (Test-SignedByShippedRoot -Path $diag.Path)) {
            return $null
        }
    }

    $titleDisp = if ($WindowTitle) { " '$WindowTitle'" } else { '' }
    $isSystemHost = ($nameLower -in @('svchost', 'rundll32', 'dllhost', 'regsvr32'))
    $isUntrusted = ($diag.IsUnpluggedUsb -or $diag.IsRemovableUsb -or -not (Test-TrustedProcessPath -ExecutablePath $diag.Path))
    $hasInjectedCode = ($diag.PrivateExecRegions.Count -gt 0 -or $diag.UnlinkedModules.Count -gt 0)

    $level = if ($isSystemHost -or $isUntrusted -or $hasInjectedCode) { 'FAILURE' } else { 'WARNING' }
    $usbDesc = if ($diag.UnpluggedDesc) { $diag.UnpluggedDesc } elseif ($diag.IsRemovableUsb) { ' [Removable USB]' } else { '' }

    return "${level}: Stream-proof window hidden from recording [WDA 0x$AffinityHex, $Visibility]$titleDisp -> $($diag.Name) (PID $ProcessId) $($diag.Path)$usbDesc"
}


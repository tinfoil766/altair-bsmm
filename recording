    if ($l -match '\\roblox\\versions\\|\\bloxstrap\\|\\fishstrap\\|\\discord\\app-|\\microsoft\\teams\\|\\spotify\\|\\antigravity\\|\\utorrent web\\|\\telegram desktop\\|\\programs\\microsoft vs code\\') { return $false }

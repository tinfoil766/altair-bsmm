function Get-RootCertificateAlerts {
    $alerts = @()
    $stores = @(
        @{ Path = 'Cert:\CurrentUser\Root';              Label = 'user root' },
        @{ Path = 'Cert:\LocalMachine\Root';             Label = 'machine root' },
        @{ Path = 'Cert:\CurrentUser\TrustedPublisher';  Label = 'user trusted publisher' },
        @{ Path = 'Cert:\LocalMachine\TrustedPublisher'; Label = 'machine trusted publisher' }
    )
    foreach ($store in $stores) {
        $certs = @()
        try { $certs = @(Get-ChildItem -Path $store.Path -ErrorAction Stop) } catch { continue }
        foreach ($cert in $certs) {
            if (-not (Test-UserInstalledRootThumbprint -Thumbprint $cert.Thumbprint)) { continue }
            $subject = [string]$cert.Subject
            $short = $subject
            if ($subject -match 'CN=([^,]+)') { $short = $matches[1] }
            $when = Get-Date $cert.NotBefore -Format 'yyyy-MM-dd'
            $tpShort = if ($cert.Thumbprint.Length -ge 8) { $cert.Thumbprint.Substring(0, 8) } else { $cert.Thumbprint }
            $desc = "'$short' ($($store.Label) store, issued $when, ${tpShort}...)"

            $isSelfSigned = Test-IsSelfSignedCertificate -Certificate $cert
            $hasCodeSign = $false
            try {
                if ($cert.EnhancedKeyUsageList) {
                    $hasCodeSign = [bool]($cert.EnhancedKeyUsageList | Where-Object { $_.Value -eq '1.3.6.1.5.5.7.3.3' -or $_.FriendlyName -match '(?i)code signing' })
                }
            } catch {}

            if ($subject -match '(?i)microsoft') {
                $alerts += "FAILURE: Forged Microsoft certificate in $($store.Label) store $desc"
            } elseif ($subject -match $script:WellKnownCaPattern) {
                $alerts += "INFO: Non-default root certificate $desc"
            } elseif ($isSelfSigned -and $hasCodeSign) {
                $privTag = if ($cert.HasPrivateKey) { ' [Private Key Installed]' } else { '' }
                $alerts += "FAILURE: Self-signed Code Signing certificate installed in $($store.Label) store (DSE / Anti-Cheat Bypass)$privTag $desc"
            } elseif ($isSelfSigned) {
                $privTag = if ($cert.HasPrivateKey) { ' [Private Key Installed]' } else { '' }
                $alerts += "FAILURE: Self-signed certificate installed in $($store.Label) store$privTag $desc"
            } elseif ($store.Label -like 'user*') {
                $alerts += "WARNING: User certificate installed in $($store.Label) store $desc"
            } else {
                $alerts += "WARNING: Unknown root certificate installed in $($store.Label) store $desc"
            }
        }
    }

    # Audit personal store for self-signed code-signing certificates with private keys
    foreach ($pStore in @('Cert:\CurrentUser\My', 'Cert:\LocalMachine\My')) {
        try {
            $myCerts = @(Get-ChildItem -Path $pStore -ErrorAction SilentlyContinue)
            foreach ($mc in $myCerts) {
                if (Test-IsSelfSignedCertificate -Certificate $mc) {
                    $hasCodeSign = $false
                    try {
                        if ($mc.EnhancedKeyUsageList) {
                            $hasCodeSign = [bool]($mc.EnhancedKeyUsageList | Where-Object { $_.Value -eq '1.3.6.1.5.5.7.3.3' -or $_.FriendlyName -match '(?i)code signing' })
                        }
                    } catch {}
                    if ($hasCodeSign -or $mc.HasPrivateKey) {
                        $sName = $mc.Subject; if ($sName -match 'CN=([^,]+)') { $sName = $matches[1] }
                        if ($mc.Subject -match $script:WellKnownCaPattern) {
                            $alerts += "INFO: Vendor certificate located in $pStore -> '$sName' (Private Key: $($mc.HasPrivateKey), Thumbprint: $($mc.Thumbprint.Substring(0,8))...)"
                        } else {
                            $alerts += "FAILURE: Self-signed code signing certificate located in $pStore -> '$sName' (Private Key: $($mc.HasPrivateKey), Thumbprint: $($mc.Thumbprint.Substring(0,8))...)"
                        }
                    }
                }
            }
        } catch {}
    }

    if (-not ($alerts | Where-Object { $_ -like 'FAILURE*' -or $_ -like 'WARNING*' })) {
        $alerts = @('SUCCESS: No unauthorized self-signed or user-installed root certificates') + $alerts
    }

function Test-IsSelfSignedCertificate {
    param($Certificate)
    if (-not $Certificate) { return $false }
    try {
        $cert = [System.Security.Cryptography.X509Certificates.X509Certificate2]$Certificate
        # 1. Direct self-signed (Subject == Issuer)
        if ($cert.Subject -and $cert.Issuer -and [string]::Equals($cert.Subject, $cert.Issuer, [System.StringComparison]::OrdinalIgnoreCase)) {
            return $true
        }
        # 2. Check if Subject matches Issuer name fields
        if ($cert.SubjectName -and $cert.IssuerName -and [string]::Equals($cert.SubjectName.Name, $cert.IssuerName.Name, [System.StringComparison]::OrdinalIgnoreCase)) {
            return $true
        }
        # 3. Chained evaluation: 1 element chain or self-signed root not in shipped roots
        $chain = New-Object System.Security.Cryptography.X509Certificates.X509Chain
        $chain.ChainPolicy.RevocationMode = 'NoCheck'
        [void]$chain.Build($cert)
        if ($chain.ChainElements.Count -eq 1) {
            $elemCert = $chain.ChainElements[0].Certificate
            if ([string]::Equals($elemCert.Subject, $elemCert.Issuer, [System.StringComparison]::OrdinalIgnoreCase)) {
                return $true
            }
            if (Test-UserInstalledRootThumbprint -Thumbprint $elemCert.Thumbprint) {
                return $true
            }
        } elseif ($chain.ChainElements.Count -gt 1) {
            $rootCert = $chain.ChainElements[$chain.ChainElements.Count - 1].Certificate
            if ([string]::Equals($rootCert.Subject, $rootCert.Issuer, [System.StringComparison]::OrdinalIgnoreCase)) {
                if (Test-UserInstalledRootThumbprint -Thumbprint $rootCert.Thumbprint) {
                    return $true
                }
            }
        }
    } catch {}
    return $false
}

function Get-FileSignatureAssessment {
    param([string]$Path)
    $res = @{
        Status        = 'Unknown'
        IsSigned      = $false
        IsSelfSigned  = $false
        IsShippedRoot = $false
        Signer        = ''
        Issuer        = ''
        Thumbprint    = ''
    }
    if ([string]::IsNullOrWhiteSpace($Path) -or -not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        $res.Status = 'NotFound'
        return $res
    }
    try {
        $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $Path -ErrorAction Stop
        $res.Status = [string]$sig.Status
        if ($sig.SignerCertificate) {
            $cert = [System.Security.Cryptography.X509Certificates.X509Certificate2]$sig.SignerCertificate
            $res.Signer = [string]$cert.Subject
            $res.Issuer = [string]$cert.Issuer
            $res.Thumbprint = [string]$cert.Thumbprint
            $res.IsSelfSigned = (Test-IsSelfSignedCertificate -Certificate $cert)
            $res.IsShippedRoot = (Test-SignedByShippedRoot -Path $Path)
            if ($res.Status -eq 'Valid' -and -not $res.IsSelfSigned -and $res.IsShippedRoot) {
                $res.IsSigned = $true
            }
        }
    } catch {
        $res.Status = 'Error'
    }
    return $res
}


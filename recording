# ===================== Silent Roblox Account Discovery =====================
function Get-SilentRobloxAccountInfo {
    if ($null -ne $script:DetectedRobloxAccount) { return $script:DetectedRobloxAccount }
    $info = @{
        Username    = ''
        UserId      = ''
        DisplayName = ''
        ProfileUrl  = ''
        AvatarUrl   = ''
        ActivePlace = ''
        PlaceUrl    = ''
    }
    try {
        try {
            $proc = Get-Process -Name 'RobloxPlayerBeta' -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($proc) {
                $cim = Get-CimInstance Win32_Process -Filter "ProcessId = $($proc.Id)" -ErrorAction SilentlyContinue
                if ($cim -and $cim.CommandLine) {
                    if ($cim.CommandLine -match '(?i)placeId%3D(\d+)|placeId=(\d+)') {
                        $info.ActivePlace = if ($matches[1]) { $matches[1] } else { $matches[2] }
                    }
                }
            }
        } catch {}

        $logDirs = @(
            (Join-Path $env:LOCALAPPDATA 'Roblox\logs'),
            (Join-Path $env:LOCALAPPDATA 'Bloxstrap\Logs'),
            (Join-Path $env:LOCALAPPDATA 'Fishstrap\Logs')
        )
        $logFiles = @()
        foreach ($d in $logDirs) {
            if (Test-Path -LiteralPath $d) {
                $logFiles += Get-ChildItem -LiteralPath $d -Filter '*.log' -File -ErrorAction SilentlyContinue |
                    Sort-Object LastWriteTime -Descending | Select-Object -First 8
            }
        }
        $logFiles = @($logFiles | Sort-Object LastWriteTime -Descending)

        $userId = $null
        $username = $null

        foreach ($f in $logFiles) {
            try {
                $fs = [System.IO.File]::Open($f.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
                $reader = New-Object System.IO.StreamReader($fs)
                $content = $reader.ReadToEnd()
                $reader.Close()
                $fs.Close()

                if (-not $userId -and $content -match 'userid:(\d{4,12})') {
                    $userId = $matches[1]
                }
                if (-not $username -and $content -match 'Players\.([a-zA-Z0-9_]{3,20})\.(?:PlayerGui|PlayerScripts|Character)') {
                    $username = $matches[1]
                }
                if (-not $username -and $content -match '"userName"\s*:\s*"([a-zA-Z0-9_]{3,20})"') {
                    $username = $matches[1]
                }
                if (-not $info.ActivePlace -and $content -match '(?i)place\s*id[:\s=]+(\d{5,16})|place\s+(\d{5,16})|Joining\s+Game\s*\(([0-9]{5,16})') {
                    $info.ActivePlace = if ($matches[1]) { $matches[1] } elseif ($matches[2]) { $matches[2] } else { $matches[3] }
                }
                if ($userId -and $info.ActivePlace) { break }
            } catch {}
        }

        if ($info.ActivePlace) {
            $info.PlaceUrl = "https://www.roblox.com/games/$($info.ActivePlace)"
        }

        if ($userId) {
            $info.UserId = [string]$userId
            $info.ProfileUrl = "https://www.roblox.com/users/$userId/profile"
            try {
                $resp = Invoke-RestMethod -Uri "https://users.roblox.com/v1/users/$userId" -Method Get -TimeoutSec 3 -ErrorAction Stop
                if ($resp.name) { $info.Username = [string]$resp.name }
                if ($resp.displayName) { $info.DisplayName = [string]$resp.displayName }
            } catch {}

            try {
                $thumbResp = Invoke-RestMethod -Uri "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=$userId&size=150x150&format=Png&isCircular=false" -Method Get -TimeoutSec 3 -ErrorAction Stop
                if ($thumbResp.data -and $thumbResp.data[0].imageUrl) {
                    $info.AvatarUrl = [string]$thumbResp.data[0].imageUrl
                }
            } catch {}
        }
        if (-not $info.Username -and $username) {
            $info.Username = $username
        }
    } catch {}
    $script:DetectedRobloxAccount = $info
    return $info
}








function Format-AnsiSummaryBlock {
    param([array]$SectionResults)
    $esc = [char]27
    $lines = @()
    foreach ($r in $SectionResults) {
        $s = $r.Summary
        $counts = @()
        if ($s.Fail -gt 0) { $counts += "$($s.Fail) fail" }
        if ($s.Warn -gt 0) { $counts += "$($s.Warn) warn" }
        if ($s.Info -gt 0) { $counts += "$($s.Info) info" }
        $countText = if ($counts.Count -gt 0) { '(' + ($counts -join ', ') + ')' } else { '' }

        $lineText = if ($r.Name.Length -ge 30) {
            "$($r.Name) [$($s.Status)]"
        } else {
            ('{0,-30} [{1}]' -f $r.Name, $s.Status)
        }
        if ($countText) {
            $lineText += "  $countText"
        }

        $colorCode = if ($s.Status -eq 'FAIL') {
            '31'
        } elseif ($s.Status -eq 'WARN') {
            '33'
        } elseif ($s.Info -gt 0) {
            '32'
        } else {
            '36'
        }

        $lines += "$esc[${colorCode}m$lineText$esc[0m"
    }
    return '```ansi' + "`n" + ($lines -join "`n") + "`n" + '```'
}








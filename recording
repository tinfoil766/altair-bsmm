public static string GetModuleHookDetails(string dllName, string functionName, bool isNtdllSyscall) {
    string key = dllName + "!" + functionName;
    IntPtr hMod = GetModuleHandle(dllName);
    if (hMod == IntPtr.Zero) {
        return _detectedHooks.ContainsKey(key) ? _detectedHooks[key] : null;
    }
    IntPtr pFunc = GetProcAddress(hMod, functionName);
    if (pFunc == IntPtr.Zero) {
        return _detectedHooks.ContainsKey(key) ? _detectedHooks[key] : null;
    }

    byte[] b = new byte[32];
    System.Runtime.InteropServices.Marshal.Copy(pFunc, b, 0, 32);
    if (isNtdllSyscall && b[0] == 0x4C && b[1] == 0x8B && b[2] == 0xD1 && b[3] == 0xB8) {
        bool hasSyscallInstr = (b[18] == 0x0F && b[19] == 0x05) || (b[8] == 0x0F && b[9] == 0x05);
        bool hasDeepJump = false;
        for (int i = 4; i < 18; i++) {
            if (b[i] == 0xE9 || b[i] == 0xCC || (b[i] == 0xFF && b[i + 1] == 0x25)) {
                hasDeepJump = true;
                break;
            }
        }
        if (hasSyscallInstr && !hasDeepJump) {
            return _detectedHooks.ContainsKey(key) ? _detectedHooks[key] : null;
        }
    }

    long target = 0;
    bool isInlinePatch = false;
    string detail = null;
    if (b[0] == 0xE9) {
        int rel32 = BitConverter.ToInt32(b, 1);
        target = pFunc.ToInt64() + 5 + rel32;
        isInlinePatch = true;
    } else if (b[0] == 0xFF && b[1] == 0x25) {
        int disp32 = BitConverter.ToInt32(b, 2);
        long ptr = pFunc.ToInt64() + 6 + disp32;
        try { target = System.Runtime.InteropServices.Marshal.ReadInt64((IntPtr)ptr); } catch {}
        if (disp32 == 0 || isNtdllSyscall) {
            isInlinePatch = true;
        }
    } else if (b[0] == 0x48 && b[1] == 0xB8) {
        target = BitConverter.ToInt64(b, 2);
        isInlinePatch = true;
    } else if (b[0] == 0xC3 || b[0] == 0xC2) {
        detail = "Immediate RET patch (0x" + b[0].ToString("X2") + ") at 0x" + pFunc.ToInt64().ToString("X");
        isInlinePatch = true;
    } else if ((b[0] == 0x31 && b[1] == 0xC0 && b[2] == 0xC3) || (b[0] == 0x48 && b[1] == 0x31 && b[2] == 0xC0 && b[3] == 0xC3)) {
        detail = "XOR EAX, EAX; RET patch at 0x" + pFunc.ToInt64().ToString("X");
        isInlinePatch = true;
    } else if (b[0] == 0xB8 && (b[5] == 0xC3 || b[5] == 0xC2)) {
        int retVal = BitConverter.ToInt32(b, 1);
        detail = "MOV EAX, 0x" + retVal.ToString("X") + "; RET patch at 0x" + pFunc.ToInt64().ToString("X");
        isInlinePatch = true;
    } else if (b[0] == 0x68 && b[5] == 0xC3) {
        target = BitConverter.ToUInt32(b, 1);
        isInlinePatch = true;
    }

    if (!isInlinePatch && !isNtdllSyscall) {
        return _detectedHooks.ContainsKey(key) ? _detectedHooks[key] : null;
    }

    if (detail == null && target != 0) {
        string sysRoot = Environment.GetFolderPath(Environment.SpecialFolder.Windows);
        try {
            foreach (ProcessModule pm in Process.GetCurrentProcess().Modules) {
                long start = pm.BaseAddress.ToInt64();
                long end = start + pm.ModuleMemorySize;
                if (target >= start && target < end) {
                    if (!isNtdllSyscall && pm.FileName.StartsWith(sysRoot, StringComparison.OrdinalIgnoreCase)) {
                        return _detectedHooks.ContainsKey(key) ? _detectedHooks[key] : null;
                    }
                    detail = pm.FileName + " (Offset: +0x" + (target - start).ToString("X") + ")";
                    break;
                }
            }
        } catch {}
        if (detail == null) {
            detail = "Unbacked Memory at 0x" + target.ToString("X") + " (Injected Shellcode / Manual Map)";
        }
    } else if (isNtdllSyscall) {
        detail = "Trampoline at 0x" + pFunc.ToInt64().ToString("X") + " (Raw: " + BitConverter.ToString(b, 0, 8) + ")";
    }

    if (detail != null) {
        _detectedHooks[key] = detail;
    }
    return _detectedHooks.ContainsKey(key) ? _detectedHooks[key] : detail;
}

public static bool UnhookFunctionFromDisk(string dllName, string funcName) {
    try {
        IntPtr hMod = GetModuleHandle(dllName);
        if (hMod == IntPtr.Zero) return false;
        IntPtr pFunc = GetProcAddress(hMod, funcName);
        if (pFunc == IntPtr.Zero) return false;

        string sysPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), dllName);
        if (!File.Exists(sysPath)) return false;

        byte[] fileBytes = File.ReadAllBytes(sysPath);
        int peHeader = BitConverter.ToInt32(fileBytes, 0x3C);
        short numSections = BitConverter.ToInt16(fileBytes, peHeader + 6);
        short optHeaderSize = BitConverter.ToInt16(fileBytes, peHeader + 20);
        int sectionOffset = peHeader + 24 + optHeaderSize;

        uint rva = (uint)(pFunc.ToInt64() - hMod.ToInt64());
        for (int i = 0; i < numSections; i++) {
            int sec = sectionOffset + (i * 40);
            uint virtSize = BitConverter.ToUInt32(fileBytes, sec + 8);
            uint virtAddr = BitConverter.ToUInt32(fileBytes, sec + 12);
            uint rawSize = BitConverter.ToUInt32(fileBytes, sec + 16);
            uint rawPtr = BitConverter.ToUInt32(fileBytes, sec + 20);
            if (rva >= virtAddr && rva < virtAddr + Math.Max(virtSize, rawSize)) {
                uint fileOff = rva - virtAddr + rawPtr;
                uint oldProt;
                if (VirtualProtect(pFunc, (UIntPtr)32, 0x40, out oldProt)) {
                    System.Runtime.InteropServices.Marshal.Copy(fileBytes, (int)fileOff, pFunc, 32);
                    VirtualProtect(pFunc, (UIntPtr)32, oldProt, out oldProt);
                    return true;
                }
            }
        }
    } catch {}
    return false;
}

private static int _cachedShmPid = -1;
public static int GetSharedMemoryBypassPid() {
    if (_cachedShmPid != -1) return _cachedShmPid;
    try {
        IntPtr h = OpenFileMappingW(0x0004, false, "Local\\__dxgi_cfg");
        if (h == IntPtr.Zero) h = OpenFileMappingW(0x0006, false, "Local\\__dxgi_cfg");
        if (h != IntPtr.Zero) {
            _cachedShmPid = -2;
            IntPtr p = MapViewOfFile(h, 0x0004, 0, 0, (UIntPtr)16);

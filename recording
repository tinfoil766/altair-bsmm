function Get-RootCertificateThumbprintSet {
    $set = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($p in @('Cert:\CurrentUser\Root', 'Cert:\LocalMachine\Root', 'Cert:\CurrentUser\TrustedPublisher', 'Cert:\LocalMachine\TrustedPublisher')) {
        try { Get-ChildItem -Path $p -ErrorAction Stop | ForEach-Object { [void]$set.Add("$p|$($_.Thumbprint)|$($_.Subject)") } } catch {}
    }
    return $set
}

function Resolve-AddressToModule {
    param([int]$ProcessId, [long]$Address)

    try {
        $p = Get-Process -Id $ProcessId -ErrorAction Stop
        foreach ($m in $p.Modules) {
            $base = $m.BaseAddress.ToInt64()
            $end = $base + $m.ModuleMemorySize
            if ($Address -ge $base -and $Address -lt $end) {
                $off = $Address - $base
                return "$($m.ModuleName)+0x$($off.ToString('X'))"
            }
        }
    } catch {}
    return "0x$($Address.ToString('X'))"
}

function Get-UsbPayloadTraces {
    $unpluggedUsb = Get-UnpluggedUsbDrives
    $payloads = @()
    $mruRoot = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\ComDlg32\OpenSavePidlMRU'

    if (Test-Path $mruRoot) {
        foreach ($sub in @(Get-ChildItem $mruRoot -ErrorAction SilentlyContinue)) {
            $props = Get-ItemProperty $sub.PSPath -ErrorAction SilentlyContinue
            if (-not $props) { continue }
            foreach ($p in $props.PSObject.Properties) {
                if ($p.Name -match '^\d+$' -and $p.Value -is [byte[]]) {
                    $bytes = [byte[]]$p.Value
                    $uStr = [System.Text.Encoding]::Unicode.GetString($bytes)
                    $aStr = [System.Text.Encoding]::ASCII.GetString($bytes)
                    $comb = "$aStr $uStr"

                    $foundDrv = $null
                    foreach ($drv in $unpluggedUsb.Keys) {
                        if ($comb -match "(?i)[/|\\]$drv" -or $comb -match "(?i)$drv\\") {
                            $foundDrv = $drv
                            break
                        }
                    }

                    $fileMatch = [regex]::Match($comb, '(?i)\b([a-zA-Z0-9_\-\. ]{2,40}\.(dll|exe|sys|bin|cfg|lua))\b')
                    if ($fileMatch.Success) {
                        $fileName = $fileMatch.Groups[1].Value.Trim()
                        $folder = ''
                        $mFolder = [regex]::Match($comb, '(?i)GO[\s_]?FAST|[a-zA-Z0-9_]{3,20}~\d')
                        if ($mFolder.Success) {
                            $folder = $mFolder.Value.Trim()
                            if ($folder -match '(?i)GOFAST') { $folder = 'GO FAST' }
                        }

                        $fullPath = if ($foundDrv -and $folder) { "$foundDrv\$folder\$fileName" }
                                    elseif ($foundDrv) { "$foundDrv\$fileName" }
                                    else { $fileName }

                        $payloads += [pscustomobject]@{
                            Drive    = $foundDrv
                            Folder   = $folder
                            FileName = $fileName
                            FullPath = $fullPath
                            Device   = if ($foundDrv -and $unpluggedUsb.ContainsKey($foundDrv)) { $unpluggedUsb[$foundDrv].Device } else { '' }
                        }
                    }
                }
            }
        }
    }
    return @($payloads)
}


            $devDesc = if ($unpluggedUsb.ContainsKey($matches[1].ToUpperInvariant())) { " ($($unpluggedUsb[$matches[1].ToUpperInvariant()].Device))" } else { '' }
            $alerts += "FAILURE: Kernel driver running from UNPLUGGED USB drive ($($matches[1]))${devDesc} - $($drv.Name) -> $resolvedPath"
            continue
        } elseif ($resolvedPath -match '^([A-Za-z]:)\\') {

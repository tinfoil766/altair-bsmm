            $procExeDir = try { if ($proc.Path) { [System.IO.Path]::GetDirectoryName($proc.Path) } else { '' } } catch { '' }
            $hasJit = ($proc.Name -in @('powershell', 'pwsh', 'chrome', 'msedge', 'brave', 'firefox', 'opera', 'operagx', 'vivaldi'))

            try {
                foreach ($mod in $proc.Modules) {
                    $path = [string]$mod.FileName
                    if (-not [string]::IsNullOrWhiteSpace($path)) {
                        [void]$pebSet.Add($path)
                        $allMods.Add($path)
                        if ($path -match '(?i)\\(clr|coreclr|mscorwks)\\.dll$') { $hasJit = $true }
                    }
                }
            } catch {}

            if ($extReady) {
                try {
                    $unbackedRegions = @()
                $rwxRegions = @()
                $vadEntries = @([ROR.ExternalScan]::ScanProcessVirtualMemory([int]$proc.Id))
                    foreach ($ve in $vadEntries) {
                        if ($ve -like 'IMAGE|*') {
                            $vPath = $ve.Substring(6)
                            if (-not [string]::IsNullOrWhiteSpace($vPath) -and ($vPath -match '(?i)\.(dll|tmp)$')) {
                                if (-not $pebSet.Contains($vPath)) {
                                    $allMods.Add($vPath)
                                    $isWin = $vPath.StartsWith($sysRoot, [System.StringComparison]::OrdinalIgnoreCase)
                                    $isSameDir = ($procExeDir -and $vPath.StartsWith($procExeDir, [System.StringComparison]::OrdinalIgnoreCase))
                                    $isDef = ($vPath -like "$env:ProgramData\Microsoft\Windows Defender\Platform\*")
                                    if ((-not $isWin) -and (-not $isSameDir) -and (-not $isDef)) {
                                        $vSig = $null
                                        try { $vSig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $vPath -ErrorAction Stop } catch {}
                                        if ((-not $vSig) -or $vSig.Status -ne 'Valid' -or (Test-UserLandProcessPath -ExecutablePath $vPath)) {
                                            $alerts += "FAILURE: PEB-unlinked hidden DLL injected in $($proc.Name) (PID $($proc.Id)) [NtQueryVirtualMemory] -> $vPath"
                                        }
                                    }
                                }
                            }
                        } elseif ($ve -like 'PRIVEXEC|*') {
                            $pParts = $ve -split '\|', 5
                            if ($pParts.Count -ge 5) {
                                $pProt = $pParts[1]
                                $pAddr = $pParts[2]
                                $pSize = $pParts[3]
                                $pTag = $pParts[4]
                                if ($pTag -in @('MANUAL_MAP_PE', 'UNBACKED_RX_EXEC')) {
                                    $unbackedRegions += [PSCustomObject]@{ Prot = $pProt; Addr = $pAddr; Size = [int64]$pSize; Tag = $pTag }
                                } elseif ($pProt -eq 'RWX' -and -not $hasJit) {
                                    $rwxRegions += [PSCustomObject]@{ Prot = $pProt; Addr = $pAddr; Size = [int64]$pSize; Tag = $pTag }
                                }
                            }
                        } elseif ($ve -like 'ORPHANED_USB_IMAGE|*') {
                            $unbackedRegions += [PSCustomObject]@{ Prot = 'RX'; Addr = 'Orphaned'; Size = [int64]4096; Tag = 'ORPHANED_USB_IMAGE' }
                        }
                    }

                    $isBrowser = ($proc.Name -in @('chrome', 'msedge', 'brave', 'firefox', 'opera', 'operagx', 'vivaldi', 'discord', 'spotify', 'slack', 'teams', 'powershell', 'pwsh')) -or $hasJit
                    if ($proc.Name -in @('obs64', 'obs32') -and $unbackedRegions.Count -gt 0) {
                        $knownPayloads = Get-UsbPayloadTraces
                        $pNames = if ($knownPayloads.Count -gt 0) {
                            ($knownPayloads | ForEach-Object { "'$($_.FileName)' (from $($_.FullPath))" } | Select-Object -Unique) -join ', '
                        } else { 'Payload from UNPLUGGED USB drive' }
                        $totalKb = 0; if ($unbackedRegions.Count -gt 0) { $uBytes = 0; foreach ($ur in $unbackedRegions) { $uBytes += [int64]$ur.Size }; $totalKb = [math]::Round($uBytes / 1024, 1) }
                        $alerts += "FAILURE: Active USB Injection running in $($proc.Name) (PID $($proc.Id)): $pNames ($totalKb KB across $($unbackedRegions.Count) unbacked memory regions)"
                    } elseif ((-not $isBrowser) -and $unbackedRegions.Count -gt 0) {
                        $totalKb = 0; if ($unbackedRegions.Count -gt 0) { $uBytes = 0; foreach ($ur in $unbackedRegions) { $uBytes += [int64]$ur.Size }; $totalKb = [math]::Round($uBytes / 1024, 1) }
                        $alerts += "FAILURE: Unbacked executable memory (manual-mapped cheat) in $($proc.Name) memory ($totalKb KB across $($unbackedRegions.Count) regions)"
                    }
                    if ((-not $isBrowser) -and $rwxRegions.Count -gt 0) {
                        $totalRwxKb = 0; if ($rwxRegions.Count -gt 0) { $rBytes = 0; foreach ($rr in $rwxRegions) { $rBytes += [int64]$rr.Size }; $totalRwxKb = [math]::Round($rBytes / 1024, 1) }
                        $alerts += "FAILURE: RWX shellcode memory region in $($proc.Name) memory ($totalRwxKb KB across $($rwxRegions.Count) regions)"
                    }
                } catch {}
            }
            foreach ($path in $allMods) {
                if ([string]::IsNullOrWhiteSpace($path)) { continue }
                if ($path.StartsWith($sysRoot, [System.StringComparison]::OrdinalIgnoreCase)) { continue }
                if ($path -like "$env:ProgramData\Microsoft\Windows Defender\Platform\*") { continue }
                if ($proc.Path -and [string]::Equals($path, $proc.Path, [System.StringComparison]::OrdinalIgnoreCase)) { continue }
                if (-not $scannedModules.Add("$($proc.Name)|$path")) { continue }

                if ($path -match '^([A-Za-z]:)\\') {
                    $drv = $matches[1].ToUpperInvariant()
                    $isUnplugged = -not (Test-Path -LiteralPath "$drv\" -ErrorAction SilentlyContinue)
                    $isRemovable = $false
                    if (-not $isUnplugged) {
                        try {
                            $di = [System.IO.DriveInfo]::new($drv)
                            if ($di.DriveType -eq [System.IO.DriveType]::Removable) { $isRemovable = $true }
                        } catch {}
                    }
                    if ($isUnplugged) {
                        $alerts += "FAILURE: Module injected into $($proc.Name) from UNPLUGGED USB ($drv) -> $path"
                        continue
                    } elseif ($isRemovable) {
                        $alerts += "FAILURE: Module injected into $($proc.Name) from REMOVABLE USB ($drv) -> $path"
                        continue
                    }
                }

                $sigInfo = Get-FileSignatureAssessment -Path $path

                if ($sigInfo.IsSelfSigned) {
                    $alerts += "FAILURE: Module signed with SELF-SIGNED certificate injected into $($proc.Name) (PID $($proc.Id)) -> $path [Signer: $($sigInfo.Signer)]"
                    continue
                } elseif ($sigInfo.Status -eq 'Valid' -and -not $sigInfo.IsShippedRoot) {
                    $alerts += "FAILURE: Module signed with test-signed / untrusted root injected into $($proc.Name) (PID $($proc.Id)) -> $path [Signer: $($sigInfo.Signer)]"
                    continue
                }
                $isSigned = $sigInfo.IsSigned
                if (-not $isSigned) {
                    $entropy = Get-FileEntropy -FilePath $path
                    $alerts += "FAILURE: Unsigned module loaded in $($proc.Name) (PID $($proc.Id)) [Entropy: $entropy] -> $path"
                } elseif (Test-UserLandProcessPath -ExecutablePath $path) {
                    $alerts += "WARNING: Userland module loaded in $($proc.Name) (PID $($proc.Id)) -> $path"
                }
            }
        }
    }

    # Verify OBS Studio Capture Mode (Display Capture vs Game/Window Capture) when OBS is active
    try {
        $obsRunning = @(Get-Process -Name @('obs64', 'obs32') -ErrorAction SilentlyContinue)
        if ($obsRunning.Count -gt 0 -and (Test-Path "$env:APPDATA\obs-studio\logs")) {
            $latestObsLog = Get-ChildItem -Path "$env:APPDATA\obs-studio\logs" -Filter '*.txt' -File -ErrorAction SilentlyContinue |
                Sort-Object LastWriteTime -Descending | Select-Object -First 1
            if ($latestObsLog) {
                $obsTxt = Get-Content -LiteralPath $latestObsLog.FullName -Raw -ErrorAction SilentlyContinue
                if ($obsTxt) {
                    $hasMonitorCap = $obsTxt -match '\(monitor_capture\)'
                    $hasGameOrWinCap = $obsTxt -match '\((game_capture|window_capture)\)'
                    if ($hasGameOrWinCap -and -not $hasMonitorCap) {
                        $alerts += "FAILURE: OBS Studio is using Game/Window Capture without Display Capture (hides external cheat overlays on recording)"
                    }
                    if ($obsTxt -match 'Hide OBS windows from screen capture:\s*true') {
                        $alerts += "WARNING: OBS Studio 'Hide OBS windows from screen capture' setting is enabled"
                    }
                }
            }
        }
    } catch {}

    # --- OBS Studio Plugins & Overlay Cheat Disk Audit ---
    try {
        $obsPluginDirs = @(
            'C:\Program Files\obs-studio\obs-plugins\64bit',
            'C:\Program Files\obs-studio\obs-plugins\32bit',
            'C:\Program Files (x86)\obs-studio\obs-plugins\64bit',
            'C:\Program Files (x86)\obs-studio\obs-plugins\32bit',
            (Join-Path $env:APPDATA 'obs-studio\plugins'),
            (Join-Path $env:LOCALAPPDATA 'obs-studio\plugins')
        )
        foreach ($op in @(Get-Process -Name @('obs64', 'obs32') -ErrorAction SilentlyContinue)) {
            try {
                if ($op.Path) {
                    $opDir = [System.IO.Path]::GetDirectoryName($op.Path)
                    $p1 = [System.IO.Path]::GetFullPath((Join-Path $opDir '..\obs-plugins\64bit'))
                    $p2 = [System.IO.Path]::GetFullPath((Join-Path $opDir '..\obs-plugins\32bit'))
                    if ($obsPluginDirs -notcontains $p1) { $obsPluginDirs += $p1 }
                    if ($obsPluginDirs -notcontains $p2) { $obsPluginDirs += $p2 }
                }
            } catch {}
        }

        foreach ($pDir in $obsPluginDirs) {
            if (-not (Test-Path -LiteralPath $pDir)) { continue }
            $pluginDlls = @(Get-ChildItem -LiteralPath $pDir -Filter '*.dll' -File -Recurse -ErrorAction SilentlyContinue)
            foreach ($pd in $pluginDlls) {
                $sig = $null
                try { $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $pd.FullName -ErrorAction Stop } catch {}
                $isValidObs = ($sig -and $sig.Status -eq 'Valid' -and ($sig.SignerCertificate.Subject -match 'OBS Project|Hugh Bailey'))
                if (-not $isValidObs) {
                    $fEntropy = Get-FileEntropy -FilePath $pd.FullName
                    $isCheatMatch = ($pd.Name -match '(?i)overlay|clarity|esp|aim|cheat|hook|inject')
                    if ($isCheatMatch) {
                        $alerts += "FAILURE: Unauthorized OBS cheat plugin detected on disk: '$($pd.Name)' ($($pd.Length) bytes, Status: $($sig.Status)) -> $($pd.FullName) [Clarity ESP / OBS Overlay Cheat, Entropy: $fEntropy]"
                    } else {
                        $alerts += "FAILURE: Unsigned OBS plugin detected: '$($pd.Name)' ($($pd.Length) bytes, Status: $($sig.Status)) -> $($pd.FullName) [Unsigned third-party plugin in OBS directory]"
                    }
                }
            }
        }
    } catch {}

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: Monitored applications module integrity verified (PEB + Kernel VAD)' }
    return @($alerts | Select-Object -Unique)
}

function Get-TransparentOverlayAlerts {
    $alerts = @()
    if (-not (Initialize-RORIntegrityApi)) { return @('WARNING: Overlay scan API unavailable') }

    $hits = [ROR.IntegrityScan]::FindTopmostOverlays()
    if ($null -eq $hits) { return @('WARNING: Failed to enumerate topmost overlays') }

    $trusted = @(
        'dwm', 'explorer', 'taskmgr', 'applicationframehost', 'systemsettings', 'textinputhost',
        'robloxplayerbeta', 'discord', 'gameoverlayui', 'nvidia overlay', 'nvcontainer',
        'gamebar', 'gamebarftserver', 'obs64', 'medal', 'steamwebhelper', 'shellexperiencehost',
        'procexp', 'procexp64', 'runtimebroker', 'startmenuexperiencehost', 'searchhost',
        'lockapp', 'widgets', 'ctfmon', 'searchui', 'sihost',
        'powershell', 'pwsh', 'windowsterminal', 'conhost', 'cmd', 'grammarly.desktop'
    )

    foreach ($hit in $hits) {
        if ($hit -like 'WDA|*') {
            $wParts = $hit -split '\|', 5
            if ($wParts.Count -ge 4) {
                $wPid = 0
                [void][int]::TryParse($wParts[1], [ref]$wPid)
                if ($wPid -le 0 -or $wPid -eq $PID) { continue }
                $affHex = $wParts[2]
                $visStr = $wParts[3]
                $wTitle = if ($wParts.Count -ge 5 -and $wParts[4]) { " '$($wParts[4])'" } else { '' }
                $wInfo = Resolve-ProcessIdentity -TargetPid $wPid
                $alertMsg = Format-WindowCaptureExclusionAlert -ProcessId $wPid -WindowTitle $wParts[4] -AffinityHex $affHex -Visibility $visStr
                if ($alertMsg) { $alerts += $alertMsg }
            }
            continue
        }

        $parts = $hit -split '\|', 3
        $pidVal = 0
        [void][int]::TryParse($parts[0], [ref]$pidVal)
        if ($pidVal -le 0 -or $pidVal -eq $PID) { continue }

        $pInfo = Resolve-ProcessIdentity -TargetPid $pidVal
        $nameLower = ($pInfo.Name -replace '\.exe$', '').ToLower()
        $style = $parts[1]
        $title = if ($parts.Count -ge 3 -and $parts[2]) { " '$($parts[2])'" } else { '' }

        if ($nameLower -in @('obs64', 'obs32')) {
            if (($parts.Count -ge 3 -and $parts[2] -match '(?i)projector|preview|overlay') -or (Test-Path 'C:\Program Files\obs-studio\obs-plugins\64bit\obs-overlay.dll')) {
                $alerts += "FAILURE: OBS Studio unauthorized overlay window detected$title (PID $pidVal, ExStyle 0x$style) -> Used as cheat ESP overlay screen"
                continue
            }
        }

        if ($nameLower -in @('powershell', 'pwsh', 'windowsterminal', 'conhost', 'cmd')) { continue }

        $chkPath = Resolve-VolumePathToDosPath $pInfo.Path
        if (-not $chkPath) { $chkPath = $pInfo.Path }

        if ($trusted -contains $nameLower -and $chkPath -and (Test-SignedByShippedRoot -Path $chkPath)) { continue }

        if ($chkPath -and $chkPath.StartsWith($env:SystemRoot, [System.StringComparison]::OrdinalIgnoreCase) -and (Test-SignedByShippedRoot -Path $chkPath)) {
            continue
        }

        if ($chkPath -and -not (Test-TrustedProcessPath -ExecutablePath $chkPath)) {
            $alerts += "FAILURE: Transparent click-through overlay window$title from untrusted path (PID $pidVal, ExStyle 0x$style) -> $chkPath"
        } else {
            $alerts += "WARNING: Transparent click-through overlay window$title detected (PID $pidVal, ExStyle 0x$style)"
        }
    }

    try {
        $monCount = [ROR.IntegrityScan]::GetSystemMetrics(80)
        if ($monCount -gt 1) {
            $alerts += "INFO: Multiple displays connected ($monCount monitors) - ensure active gameplay monitor is captured"
        }
    } catch {}

    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: No suspicious transparent or stream-proof overlay windows found' }
    return @($alerts | Select-Object -Unique)
}

# --- PROCESS EXPLORER & TASK MANAGER INTEGRITY AUDIT ---
function Get-TaskManagerIntegrityAlerts {
    $alerts = @()
    
    # 1. IFEO Check for Taskmgr.exe, procexp.exe, and procexp64.exe
    $ifeoKeys = @('Taskmgr.exe', 'procexp.exe', 'procexp64.exe')
    foreach ($exe in $ifeoKeys) {
        $ifeoPath = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\$exe"
        if (Test-Path $ifeoPath) {
            $debugger = (Get-ItemProperty -Path $ifeoPath -ErrorAction SilentlyContinue).Debugger
            if ($debugger) {
                if ($exe -eq 'Taskmgr.exe' -and ($debugger -match 'procexp(64)?\.exe')) {
                    $cleanDbg = $debugger.Trim('"', "'")
                    $dbgSig = if (Test-Path $cleanDbg) { Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $cleanDbg -ErrorAction SilentlyContinue } else { $null }
                    if ($dbgSig -and $dbgSig.Status -eq 'Valid' -and ($dbgSig.SignerCertificate.Subject -match 'Microsoft|Sysinternals')) {
                        $alerts += "INFO: Task Manager replaced by Sysinternals Process Explorer: $cleanDbg"
                    } else {
                        $alerts += "FAILURE: Taskmgr.exe redirected to untrusted debugger: $debugger"
                    }
                } else {
                    $alerts += "FAILURE: IFEO Redirection detected on $($exe)! Launches: $debugger"
                }
            }
        }
    }

    # 2. Sysinternals Process Explorer Active Process & Module Integrity
    $peProcesses = Get-Process -Name @('procexp', 'procexp64') -ErrorAction SilentlyContinue
    if ($peProcesses) {
        foreach ($proc in $peProcesses) {
            $path = $proc.Path
            if ($path -and (Test-Path $path)) {
                $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $path -ErrorAction SilentlyContinue
                if ($sig.Status -ne 'Valid' -or ($sig.SignerCertificate.Subject -notmatch 'Microsoft|Sysinternals')) {
                    $alerts += "FAILURE: Process Explorer ($($proc.Name) PID $($proc.Id)) binary signature invalid: $($sig.Status)"
                }
            }
            try {
                foreach ($mod in $proc.Modules) {
                    $modPath = [string]$mod.FileName
                    if ([string]::IsNullOrWhiteSpace($modPath)) { continue }
                    if ($modPath.StartsWith($env:SystemRoot, [System.StringComparison]::OrdinalIgnoreCase)) { continue }
                    if (Test-Path $modPath) {
                        $sigInfo = Get-FileSignatureAssessment -Path $modPath
                        if ($sigInfo.IsSelfSigned) {
                            $alerts += "FAILURE: Module with SELF-SIGNED certificate in Process Explorer PID $($proc.Id) -> $($mod.ModuleName) [Signer: $($sigInfo.Signer)] -> $modPath"
                            continue
                        }
                        $isSigned = $sigInfo.IsSigned
                        if (-not $isSigned) {
                            $entropy = Get-FileEntropy -FilePath $modPath
                            $alerts += "FAILURE: Unsigned module in Process Explorer PID $($proc.Id) -> $($mod.ModuleName) [Entropy: $entropy] -> $modPath"
                        } elseif (Test-UserLandProcessPath -ExecutablePath $modPath) {
                            $alerts += "WARNING: Userland module in Process Explorer PID $($proc.Id) -> $modPath"
                        }
                    }
                }
            } catch {
                $alerts += "WARNING: Could not inspect modules for $($proc.Name) (PID $($proc.Id))"
            }
        }
    }

    # 3. Windows Task Manager Binary & Module Check
    $taskmgrBinary = "$env:SystemRoot\System32\Taskmgr.exe"
    if (-not (Test-Path $taskmgrBinary)) {
        $alerts += "FAILURE: Taskmgr.exe missing from System32!"
    } else {
        $sig = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -FilePath $taskmgrBinary -ErrorAction SilentlyContinue
        if ($sig.Status -ne 'Valid' -or $sig.SignerCertificate.Subject -notmatch 'Microsoft Windows') {
            $alerts += "FAILURE: Taskmgr.exe binary signature invalid/missing: $($sig.Status)"
        }
    }

    $tmProcesses = Get-Process -Name 'Taskmgr' -ErrorAction SilentlyContinue
    if ($tmProcesses) {
        foreach ($proc in $tmProcesses) {
            if ($proc.Path -and $proc.Path -ne $taskmgrBinary) {
                $alerts += "FAILURE: Taskmgr is running from abnormal path: $($proc.Path)"
            }

            try {
                foreach ($mod in $proc.Modules) {
                    $modPath = [string]$mod.FileName
                    if ([string]::IsNullOrWhiteSpace($modPath)) { continue }
                    if ($modPath.StartsWith($env:SystemRoot, [System.StringComparison]::OrdinalIgnoreCase)) { continue }
                    if (Test-Path $modPath) {
                        $sigInfo = Get-FileSignatureAssessment -Path $modPath
                        if ($sigInfo.IsSelfSigned) {
                            $alerts += "FAILURE: Module with SELF-SIGNED certificate in Taskmgr PID $($proc.Id) -> $($mod.ModuleName) [Signer: $($sigInfo.Signer)] -> $modPath"
                            continue
                        }
                        $isSigned = $sigInfo.IsSigned
                        if (-not $isSigned) {
                            $entropy = Get-FileEntropy -FilePath $modPath
                            $alerts += "FAILURE: Suspicious module in Taskmgr PID $($proc.Id) -> $($mod.ModuleName) [Entropy: $entropy] -> $modPath"
                        }
                    }
                }
            } catch {}
        }
    }

    if (-not ($alerts | Where-Object { $_ -like 'FAILURE*' })) {
        $alerts = @('SUCCESS: Process Explorer & Task Manager integrity verified (no IFEO hijack, signed modules intact)') + $alerts
    }
    return @($alerts | Select-Object -Unique)
}

function Get-MemoryIntegrityAlerts {

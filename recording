                        if ($isUnplugged -or $isRemovable) {
                            $devDesc = if ($unpluggedUsb.ContainsKey($drv)) { " [$($unpluggedUsb[$drv].Device)]" } else { '' }
                            $tag = if ($isUnplugged) { "UNPLUGGED USB$devDesc" } else { 'removable USB drive' }
                            if ($fPath -match '(?i)\.cfg$') {
                                $hits += "FAILURE: File dialog selected config file (.cfg) from $tag ($drv) [LastActivityView OpenSaveMRU] -> $fPath"
                            } elseif ($kw -or $fPath -match '(?i)\.dll$') {
                                $hits += "FAILURE: File dialog selected payload from $tag ($drv) [LastActivityView OpenSaveMRU] -> $fPath"
                            } else {
                                $hits += "FAILURE: File dialog selected file from $tag ($drv) [LastActivityView OpenSaveMRU] -> $fPath"
                            }
                        }
                    }
                }
            }
        }
    } catch {}

    # 7. ShellBags (BagMRU)   catches folders browsed on unplugged USB drives in Windows File Explorer
    try {
        $bagRoot = 'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\BagMRU'
        if (Test-Path $bagRoot) {
            $bagDrives = @{}
            Get-ChildItem $bagRoot -Recurse -ErrorAction SilentlyContinue | ForEach-Object {
                $p = Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue
                if (-not $p) { return }
                foreach ($pr in $p.PSObject.Properties) {
                    if ($pr.Value -is [byte[]]) {
                        $a = [System.Text.Encoding]::ASCII.GetString($pr.Value)
                        foreach ($uDrv in $unpluggedUsb.Keys) {
                            if ($a -match "(?i)/$uDrv[\\/]") {
                                $childKey = "$($_.PSPath)\$($pr.Name)"
                                $bagDrives[$childKey] = $uDrv
                                $hits += "FAILURE: UNPLUGGED USB drive ($uDrv [$($unpluggedUsb[$uDrv].Device)]) was opened in Windows File Explorer [ShellBags]"
                            }
                        }
                    }
                }
            }
            foreach ($k in $bagDrives.Keys) {
                $drv = $bagDrives[$k]
                if (Test-Path $k) {
                    $sub = Get-ItemProperty $k -ErrorAction SilentlyContinue
                    foreach ($spr in $sub.PSObject.Properties) {
                        if ($spr.Value -is [byte[]] -and $spr.Name -match '^\d+$') {
                            $uRaw = [System.Text.Encoding]::Unicode.GetString($spr.Value)
                            $aRaw = [System.Text.Encoding]::ASCII.GetString($spr.Value)
                            $comb = "$uRaw $aRaw"
                            $fileMatches = [regex]::Matches($comb, '(?i)\b([A-Za-z0-9_\-\. ]{1,60}\.(exe|dll|sys|bat|ps1|vbs|zip|rar|cfg))\b')
                            foreach ($fm in $fileMatches) {
                                $fName = $fm.Groups[1].Value.Trim()
                                if ($fName -notmatch '(?i)^shell32\.dll$') {
                                    $hits += "FAILURE: Binary/Payload on UNPLUGGED USB drive ($drv) accessed/browsed in Explorer: $drv\$fName [ShellBags]"
                                }
                            }
                            $uM = [regex]::Matches($uRaw, '[A-Za-z0-9_\-\. ]{2,40}')
                            $cleanFolder = ''
                            foreach ($um in $uM) {
                                $val = $um.Value.Trim()
                                if ($val.Length -gt 2 -and $val -notmatch '^[A-Za-z0-9]{1,2}$' -and $val -notmatch '(?i)\.(exe|dll|sys)$') {
                                    $cleanFolder = $val
                                    break
                                }
                            }
                            if ($cleanFolder) {
                                $hits += "FAILURE: Folder on UNPLUGGED USB drive ($drv) was browsed in Windows Explorer: $drv\$cleanFolder [ShellBags]"
                            }
                        }
                    }
                }
            }
        }
    } catch {}

    # 8. MuiCache (LastActivityView "Execute Program")   catches executables run from USB by DOS drive letter
    try {
        $mui = Get-ItemProperty 'HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache' -ErrorAction SilentlyContinue
        if ($mui) {
            foreach ($p in $mui.PSObject.Properties) {
                if ($p.Name -match '^([A-Za-z]:\\.+?\.(exe|dll|bat|ps1))(\.FriendlyAppName|\.ApplicationCompany)?$') {
                    $drv = $matches[1].Substring(0, 2).ToUpperInvariant()
                    $cleanPath = $p.Name -replace '\.(FriendlyAppName|ApplicationCompany)$', ''
                    $isUnplugged = ($unpluggedUsb.ContainsKey($drv) -or ($mountedRoots.Count -gt 0 -and -not $mountedRoots.ContainsKey($drv)))
                    $isRemovable = ($mountedRoots[$drv] -eq 'Removable')
                    if ($isUnplugged -or $isRemovable) {
                        $devDesc = if ($unpluggedUsb.ContainsKey($drv)) { " [$($unpluggedUsb[$drv].Device)]" } else { '' }
                        $tag = if ($isUnplugged) { "UNPLUGGED USB$devDesc" } else { 'removable USB drive' }
                        $hits += "FAILURE: Program executed from $tag ($drv) [LastActivityView MuiCache] -> $cleanPath"
                    }
                }
            }
        }
    } catch {}

    # 9. AppCompatCache / ShimCache (LastActivityView "Run Program (AppCompatCache)")   catches executables run from USB
    try {
        $acc = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\AppCompatCache' -ErrorAction SilentlyContinue).AppCompatCache
        if ($acc) {
            $str = [System.Text.Encoding]::Unicode.GetString($acc)
            $seenShim = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
            $shimPattern = '(?i)([A-Za-z]:\\[^\r\n\x00-\x1F\x7F-\xFF]+\.(exe|dll)|\\Device\\HarddiskVolume\d+\\[^\r\n\x00-\x1F\x7F-\xFF]+\.(exe|dll))'
            foreach ($m in [regex]::Matches($str, $shimPattern)) {
                $p = $m.Value
                if (-not $seenShim.Add($p)) { continue }
                $drv = if ($p -match '^([A-Za-z]:)\\') { $matches[1].ToUpperInvariant() } else { '' }
                $isUnplugged = $false
                $isRemovable = $false
                $devDesc = ''
                if ($drv) {
                    $isUnplugged = ($unpluggedUsb.ContainsKey($drv) -or ($mountedRoots.Count -gt 0 -and -not $mountedRoots.ContainsKey($drv)))
                    $isRemovable = ($mountedRoots[$drv] -eq 'Removable')
                    if ($unpluggedUsb.ContainsKey($drv)) { $devDesc = " [$($unpluggedUsb[$drv].Device)]" }
                } elseif ($p -match '^(\\Device\\HarddiskVolume\d+)\\(.+)$') {
                    $vKey = $matches[1].ToLowerInvariant()
                    $vMap = Get-MountedVolumeMap
                    if (-not $vMap.ContainsKey($vKey)) {
                        $isUnplugged = $true
                        $devDesc = " [Unmounted Volume: $vKey]"
                    } elseif ($vMap[$vKey].DriveType -eq 'Removable') {
                        $isRemovable = $true
                    }
                }
                if ($isUnplugged -or $isRemovable) {
                    $tag = if ($isUnplugged) { "UNPLUGGED USB$devDesc" } else { 'removable USB drive' }
                    $isWindowsSetup = ($p -match '(?i)\\(\$windows\.~bt|sources|windows\\servicing)\\' -or $p -match '(?i)\\(setup|tiworker|trustedinstaller|dismhost|msiexec)\.exe$')
                    if (-not $isWindowsSetup) {
                        $hits += "FAILURE: Executable executed from $tag ($drv) [LastActivityView AppCompatCache] -> $p"
                    }
                }
            }
        }
    } catch {}

    return $hits
}

function Convert-DevicePathToDosPath {
    param([string]$RawPath)
    if ([string]::IsNullOrWhiteSpace($RawPath)) { return $null }
    if ($RawPath -match '^[A-Za-z]:\\') { return $RawPath }
    if ($RawPath -match '^(\\Device\\HarddiskVolume\d+)\\(.+)$') {
        $volKey = $matches[1].ToLowerInvariant()
        $rel = $matches[2]
        $vMap = Get-MountedVolumeMap
        if ($vMap.ContainsKey($volKey)) {
            return (Join-Path $vMap[$volKey].Root $rel)
        }
        return $null
    }
    return $null
}

$script:CachedVadSuspectDlls = $null

function Get-VadSuspectDllList {
    if ($null -ne $script:CachedVadSuspectDlls) { return $script:CachedVadSuspectDlls }
    $list = New-Object 'System.Collections.Generic.List[object]'
    if (-not (Initialize-ExternalScanApi)) {
        $script:CachedVadSuspectDlls = $list
        return $list
    }
    try {
        $shmPid = 0
        if (Initialize-RORIntegrityApi) {
            try { $shmPid = [ROR.IntegrityScan]::GetSharedMemoryBypassPid() } catch {}
        }
        $checkPids = New-Object 'System.Collections.Generic.List[int]'
        if ($PID -gt 0) { $checkPids.Add($PID) }
        if ($shmPid -gt 0) { $checkPids.Add($shmPid) }
        foreach ($tName in @('spotify', 'obs64', 'Discord', 'RobloxPlayerBeta', 'powershell', 'pwsh')) {
            $tProcs = @(Get-Process -Name $tName -ErrorAction SilentlyContinue)
            foreach ($p in @($tProcs | Where-Object { $_.MainWindowHandle -ne 0 })) {
                if (-not $checkPids.Contains($p.Id)) { $checkPids.Add($p.Id) }
            }
            foreach ($p in @($tProcs | Select-Object -First 3)) {
                if (-not $checkPids.Contains($p.Id)) { $checkPids.Add($p.Id) }
            }
        }
        foreach ($cpid in $checkPids) {
            try {
                $pInfo = Resolve-ProcessIdentity -TargetPid $cpid
                $procDir = if ($pInfo.Path) { [System.IO.Path]::GetDirectoryName($pInfo.Path) } else { '' }
                foreach ($ve in @([ROR.ExternalScan]::ScanProcessVirtualMemory([int]$cpid))) {
                    if ($ve -like 'IMAGE|*') {
                        $vPath = $ve.Substring(6)
                        if ($vPath -match '(?i)\.dll$' -and
                            -not $vPath.StartsWith($env:SystemRoot, [System.StringComparison]::OrdinalIgnoreCase) -and
                            $vPath -notmatch '(?i)\\(Roblox|Bloxstrap|Fishstrap)\\Versions\\' -and
                            $vPath -notlike "$env:ProgramData\Microsoft\Windows Defender\Platform\*") {
                            if ($procDir -and $vPath.StartsWith($procDir, [System.StringComparison]::OrdinalIgnoreCase)) { continue }
                            $vDir = [System.IO.Path]::GetDirectoryName($vPath)
                            $vLeaf = [System.IO.Path]::GetFileName($vPath)
                            $list.Add([pscustomobject]@{
                                Pid           = $cpid
                                Proc          = $pInfo.Name
                                Leaf          = $vLeaf
                                Path          = $vPath
                                Dir           = $vDir
                                IsOrphanedUsb = $false
                                IsManualMap   = $false
                            })
                        }
                    } elseif ($ve -like 'ORPHANED_USB_IMAGE|*') {
                        $oParts = $ve -split '\|', 3
                        $addr = if ($oParts.Count -ge 2) { $oParts[1] } else { 'unknown' }
                        $sz = if ($oParts.Count -ge 3) { $oParts[2] } else { 'unknown' }
                        $list.Add([pscustomobject]@{
                            Pid           = $cpid
                            Proc          = $pInfo.Name
                            Leaf          = 'ORPHANED_USB_IMAGE'
                            Path          = "Dismounted image at $addr ($sz bytes)"
                            Dir           = ''
                            IsOrphanedUsb = $true
                            IsManualMap   = $false
                        })
                    } elseif ($ve -like 'PRIVEXEC|*') {
                        $pParts = $ve -split '\|', 5
                        if ($pParts.Count -ge 5 -and $pParts[4] -eq 'MANUAL_MAP_PE') {
                            $list.Add([pscustomobject]@{
                                Pid           = $cpid
                                Proc          = $pInfo.Name
                                Leaf          = 'MANUAL_MAP_PE'
                                Path          = "$($pParts[1]) at $($pParts[2]) ($($pParts[3]) bytes)"
                                Dir           = ''
                                IsOrphanedUsb = $false
                                IsManualMap   = $true
                            })
                        }
                    }
                }
            } catch {}
        }
    } catch {}
    $script:CachedVadSuspectDlls = $list
    return $list
}

function Resolve-CfgCreatorBinary {
    param([string]$CfgPath, [long]$CfgTicks = 0)
    $owner = ''
    try {
        if ('ROR.FastEntropy' -as [type]) {
            $owner = [ROR.FastEntropy]::FindAssociatedBinary($CfgPath)
        }
        # Check Kernel VAD injected/unlinked DLLs across monitored processes (e.g. GoFastHook.dll in Spotify.exe)
        if (-not $owner) {
            $cfgDir = try { [System.IO.Path]::GetDirectoryName($CfgPath) } catch { '' }
            $cfgParent = try { if ($cfgDir) { [System.IO.Path]::GetDirectoryName($cfgDir) } else { '' } } catch { '' }
            $vadList = @(Get-VadSuspectDllList)
            foreach ($item in $vadList) {
                $vDir = $item.Dir
                if (($cfgDir -and $vDir -and $cfgDir.StartsWith($vDir, [System.StringComparison]::OrdinalIgnoreCase)) -or
                    ($cfgParent -and $vDir -and $vDir.StartsWith($cfgParent, [System.StringComparison]::OrdinalIgnoreCase))) {
                    $owner = "$($item.Leaf) [Injected in $($item.Proc) PID $($item.Pid)] ($($item.Path))"
                    break
                }
            }
            if (-not $owner -and $vadList.Count -gt 0) {
                $first = $vadList[0]
                $owner = "$($first.Leaf) [Injected in $($first.Proc) PID $($first.Pid)] ($($first.Path))"
            }
        }
        # Check BAM execution history for unsigned/userland .exe run around the same time
        if (-not $owner -and $CfgTicks -gt 0) {
            $cfgTime = [DateTime]::new($CfgTicks)
            foreach ($bam in @(Get-BamEntries)) {
                if (-not $bam.Raw -or $bam.Raw -match '(?i)\\windows\\|\\program files') { continue }
                $bPath = Convert-DevicePathToDosPath -RawPath $bam.Raw
                if (-not $bPath -or -not (Test-UserLandProcessPath -ExecutablePath $bPath)) { continue }
                if ($bam.Time -and [Math]::Abs(($cfgTime - $bam.Time).TotalMinutes) -le 15) {
                    $owner = "$($bam.Leaf) [BAM @ $(Get-Date $bam.Time -Format 'HH:mm:ss')] ($bPath)"
                    break
                }
            }
        }
        if (-not $owner -and (Initialize-RORIntegrityApi)) {
            $shmPid = [ROR.IntegrityScan]::GetSharedMemoryBypassPid()
            if ($shmPid -gt 0) {
                $pInfo = Resolve-ProcessIdentity -TargetPid $shmPid
                $owner = "$($pInfo.Name) (PID $shmPid)"
            }
        }
    } catch {}
    return $owner
}

function Get-SuspiciousHighEntropyFileAlerts {
    $alerts = @()
    try { [void](Get-NtdllSyscallIntegrityAlerts) } catch {}
    
    $targetFolders = @(
        (Join-Path $env:USERPROFILE 'Downloads'),
        (Join-Path $env:USERPROFILE 'Desktop'),
        (Join-Path $env:USERPROFILE 'Documents'),
        $env:TEMP,
        "$env:SystemDrive\"
    )

    $scannedFiles = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)

    foreach ($folder in $targetFolders) {
        if (-not (Test-Path -LiteralPath $folder)) { continue }

        $files = Get-ChildItem -LiteralPath $folder -File -ErrorAction SilentlyContinue |
            Where-Object { $_.Extension -match '(?i)^\.(exe|dll)$' -and $_.Length -gt 50KB -and $_.Length -lt 30MB } |
            Sort-Object LastWriteTime -Descending | Select-Object -First 20

        foreach ($file in $files) {
            if (-not $scannedFiles.Add($file.FullName)) { continue }

            $entropy = Get-FileEntropy -FilePath $file.FullName
            if ($entropy -lt 7.20 -or $entropy -gt 7.95) { continue }

            if (Test-SignedByShippedRoot -Path $file.FullName) { continue }

            $kw = Get-MatchedCheatKeyword -Text $file.Name
            $kwTag = if ($kw) { " [$kw]" } else { "" }
            $alerts += "WARNING: High-entropy packed binary$kwTag [Entropy: $entropy] -> $($file.FullName)"
        }
    }

    # Collect extra directories from running processes, BAM entries, and Kernel VAD injected DLLs so deep folders are also scanned
    $extraCfgDirs = New-Object 'System.Collections.Generic.List[string]'
    try {
        foreach ($item in @(Get-VadSuspectDllList)) {
            if ($item.Dir -and -not $extraCfgDirs.Contains($item.Dir)) {
                $extraCfgDirs.Add($item.Dir)
            }
        }
        foreach ($bam in @(Get-BamEntries)) {
            $bPath = Convert-DevicePathToDosPath -RawPath $bam.Raw
            if ($bPath -and (Test-UserLandProcessPath -ExecutablePath $bPath)) {
                $bd = [System.IO.Path]::GetDirectoryName($bPath)
                if ($bd -and -not $extraCfgDirs.Contains($bd)) { $extraCfgDirs.Add($bd) }
            }
        }
    } catch {}

    # Engine 1 & 2: C# MFT ($MFT) + USN Change Journal ($UsnJrnl:$J) + Directory .cfg Scanner & Creator Attribution
    try {
        $logon = Get-LogonTime
        $mountedRoots = @{}
        try {
            foreach ($d in [System.IO.DriveInfo]::GetDrives()) {
                if ($d.IsReady) {
                    $mountedRoots[$d.Name.Substring(0, 2).ToUpperInvariant()] = [string]$d.DriveType
                }
            }
        } catch {}

        if ('ROR.FastEntropy' -as [type]) {
            $scanCutoff = (Get-Date).AddDays(-14).Ticks
            $cfgHits = @([ROR.FastEntropy]::ScanCheatConfigs($extraCfgDirs.ToArray(), $scanCutoff))
            foreach ($hit in $cfgHits) {
                $parts = $hit -split '\|', 5
                if ($parts.Count -ge 5) {
                    $kind = $parts[0]
                    $key = $parts[1]
                    $cfgFile = $parts[2]
                    $owner = $parts[3]
                    $ticks = 0L
                    [void][long]::TryParse($parts[4], [ref]$ticks)
                    if (-not $owner) { $owner = Resolve-CfgCreatorBinary -CfgPath $cfgFile -CfgTicks $ticks }
                    $ownerTag = if ($owner) { " [Created/Owned by: $owner]" } else { "" }
                    $drv = if ($cfgFile.Length -ge 2 -and $cfgFile[1] -eq ':') { $cfgFile.Substring(0, 2).ToUpperInvariant() } else { '' }
                    $isRemovableUsb = ($drv -and $mountedRoots.ContainsKey($drv) -and $mountedRoots[$drv] -eq 'Removable')
                    $usbTag = if ($isRemovableUsb) { " [ON REMOVABLE USB]" } else { "" }

                    if ($kind -eq 'MATCH') {
                        $alerts += "FAILURE: Cheat config file (.cfg) detected [$key]$usbTag$ownerTag -> $cfgFile"
                    } elseif ($kind -eq 'RECENT') {
                        $alerts += "FAILURE: New config file (.cfg) created/saved since logon$usbTag$ownerTag -> $cfgFile"
                    } elseif ($kind -eq 'USN') {
                        $twoWeeksAgo = (Get-Date).AddDays(-14)
                        if ($ticks -gt 0) {
                            $dt = [DateTime]::new($ticks)
                            if ($dt -lt $twoWeeksAgo) { continue }
                            $tsTag = if ($dt.Date -eq (Get-Date).Date) { " ($($dt.ToString('HH:mm:ss')))" } else { " ($($dt.ToString('yyyy-MM-dd HH:mm:ss')))" }
                        } else { $tsTag = "" }
                        $alerts += "FAILURE: USN Journal Trace: .cfg file [$key]$tsTag$usbTag$ownerTag -> $cfgFile"
                    } elseif ($kind -eq 'USB_CFG') {
                        $alerts += "FAILURE: Configuration file (.cfg) detected on REMOVABLE USB drive$ownerTag -> $cfgFile"
                    }
                }
            }
        }
    } catch {}

    # Engine 3: Real-time FileSystemWatcher events captured during scan
    try {
        if ('ROR.FastEntropy' -as [type]) {
            foreach ($ev in @([ROR.FastEntropy]::DrainCfgEvents())) {
                $parts = $ev -split '\|', 3
                if ($parts.Count -ge 2) {
                    $act = $parts[0]
                    $cfgFile = $parts[1]
                    $owner = if ($parts.Count -ge 3 -and $parts[2]) { $parts[2] } else { Resolve-CfgCreatorBinary -CfgPath $cfgFile }
                    $ownerTag = if ($owner) { " [Created/Saved by: $owner]" } else { "" }
                    $drv = if ($cfgFile.Length -ge 2 -and $cfgFile[1] -eq ':') { $cfgFile.Substring(0, 2).ToUpperInvariant() } else { '' }
                    $usbTag = if ($drv -and $mountedRoots.ContainsKey($drv) -and $mountedRoots[$drv] -eq 'Removable') { " [ON REMOVABLE USB]" } else { "" }
                    $alerts += "FAILURE: Config file (.cfg) $act$usbTag$ownerTag -> $cfgFile"
                }
            }
        }
    } catch {}

    # Engine 4: Windows Recent Items (.lnk), JumpLists & ComDlg32 OpenSavePidlMRU for .cfg files (including Removable & Unplugged USB)
    try {
        $recentDir = [Environment]::GetFolderPath('Recent')
        if ($recentDir -and (Test-Path -LiteralPath $recentDir)) {
            $lnkFiles = @()
            $lnkFiles += @(Get-ChildItem -LiteralPath $recentDir -Filter '*.lnk' -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime -ge (Get-Date).AddDays(-14) })
            $autoDir = Join-Path $recentDir 'AutomaticDestinations'
            if (Test-Path -LiteralPath $autoDir) {
                $lnkFiles += @(Get-ChildItem -LiteralPath $autoDir -Filter '*.automaticDestinations-ms' -File -ErrorAction SilentlyContinue |
                    Where-Object { $_.LastWriteTime -ge (Get-Date).AddDays(-14) })
            }

            foreach ($f in $lnkFiles) {
                try {
                    $b = [System.IO.File]::ReadAllBytes($f.FullName)
                    for ($i = 0; $i -le ($b.Length - 0x60); $i++) {
                        if ($b[$i] -eq 0x4C -and $b[$i+1] -eq 0 -and $b[$i+2] -eq 0 -and $b[$i+3] -eq 0 -and
                            $b[$i+4] -eq 0x01 -and $b[$i+5] -eq 0x14 -and $b[$i+6] -eq 0x02 -and $b[$i+7] -eq 0 -and
                            $b[$i+12] -eq 0xC0 -and $b[$i+19] -eq 0x46) {
                            $flags = [BitConverter]::ToUInt32($b, $i + 0x14)
                            $pos = $i + 0x4C
                            if (($flags -band 1) -ne 0 -and ($pos + 2) -le $b.Length) {
                                $idLen = [BitConverter]::ToUInt16($b, $pos)
                                $pos += 2 + $idLen
                            }
                            if (($flags -band 2) -ne 0 -and ($pos + 0x1C) -le $b.Length) {
                                $liFlags = [BitConverter]::ToUInt32($b, $pos + 8)
                                if (($liFlags -band 1) -ne 0) {
                                    $volOff = [BitConverter]::ToUInt32($b, $pos + 0x0C)
                                    $baseOff = [BitConverter]::ToUInt32($b, $pos + 0x10)
                                    $vPos = $pos + $volOff
                                    if (($vPos + 0x10) -le $b.Length) {
                                        $driveType = [BitConverter]::ToUInt32($b, $vPos + 4)
                                        $bPos = $pos + $baseOff
                                        $bEnd = $bPos
                                        while ($bEnd -lt $b.Length -and $b[$bEnd] -ne 0 -and ($bEnd - $bPos) -lt 260) { $bEnd++ }
                                        $localPath = if ($bEnd -gt $bPos) { [System.Text.Encoding]::Default.GetString($b, $bPos, $bEnd - $bPos) } else { '' }
                                        if ($localPath -match '(?i)\.cfg$') {
                                            $drvPrefix = if ($localPath -match '^([A-Za-z]:)\\') { $matches[1].ToUpperInvariant() } else { '' }
                                            $isUnmounted = ($drvPrefix -and $mountedRoots.Count -gt 0 -and -not $mountedRoots.ContainsKey($drvPrefix))
                                            $isRemovable = ($drvPrefix -and $mountedRoots.ContainsKey($drvPrefix) -and $mountedRoots[$drvPrefix] -eq 'Removable')
                                            $kw = Get-MatchedCheatKeyword -Text $localPath
                                            $srcTag = if ($f.Extension -ieq '.lnk') { 'Recent LNK' } else { 'JumpList' }
                                            if ($isUnmounted) {
                                                $alerts += "FAILURE: Config file (.cfg) from UNPLUGGED USB / disconnected drive ($drvPrefix) [$srcTag] -> $localPath"
                                            } elseif ($driveType -eq 2 -or $isRemovable) {
                                                $alerts += "FAILURE: Config file (.cfg) on REMOVABLE USB drive ($drvPrefix) [$srcTag] -> $localPath"
                                            } elseif ($kw) {
                                                $alerts += "FAILURE: Recent cheat config shortcut [$kw] [$srcTag] -> $localPath"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                } catch {}
            }
        }
    } catch {}

    # Engine 4b: ComDlg32 OpenSavePidlMRU for .cfg file selection
    try {
        $cfgMru = Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\ComDlg32\OpenSavePidlMRU\cfg' -ErrorAction SilentlyContinue
        if ($cfgMru) {
            foreach ($p in $cfgMru.PSObject.Properties) {
                if ($p.Name -match '^\d+$' -and $p.Value -is [byte[]]) {
                    $uStr = [System.Text.Encoding]::Unicode.GetString($p.Value)
                    $aStr = [System.Text.Encoding]::ASCII.GetString($p.Value)
                    $combined = "$uStr $aStr"
                    foreach ($m in [regex]::Matches($combined, '([A-Za-z]:\\[\w\s\\.-]+\.cfg)')) {
                        $fPath = $m.Value
                        $drv = $fPath.Substring(0, 2).ToUpperInvariant()
                        $isUnplugged = ($mountedRoots.Count -gt 0 -and -not $mountedRoots.ContainsKey($drv))
                        $isRemovable = ($mountedRoots[$drv] -eq 'Removable')
                        $kw = Get-MatchedCheatKeyword -Text $fPath
                        $kwTag = if ($kw) { " [$kw]" } else { "" }
                        if ($isUnplugged) {
                            $alerts += "FAILURE: Open/Save dialog selected .cfg from UNPLUGGED USB ($drv)$kwTag -> $fPath"
                        } elseif ($isRemovable) {
                            $alerts += "FAILURE: Open/Save dialog selected .cfg on REMOVABLE USB ($drv)$kwTag -> $fPath"
                        } elseif ($kw) {
                            $alerts += "FAILURE: Open/Save dialog selected cheat config [$kw] -> $fPath"
                        }
                    }
                }
            }
        }
    } catch {}

    try {
        Get-ChildItem -LiteralPath $env:TEMP -Filter 'psh*.tmp' -File -ErrorAction SilentlyContinue |
            Where-Object { $_.Length -gt 10KB -and $_.Length -lt 5MB } | ForEach-Object {
                $alerts += "FAILURE: Anti-screenshare PowerShell hook payload DLL found -> $($_.FullName)"
            }
    } catch {}

    if ($alerts.Count -eq 0) {
        $alerts += 'SUCCESS: No high-entropy packed binaries or cheat configs detected'
    }

    return @($alerts | Select-Object -Unique)
}


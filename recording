function Get-DetachedProcessImagePath {
    param([int]$ProcessId)
    if (-not ('ROR.DetachedImage' -as [type])) {
        Add-Type -TypeDefinition @"
using System;
using System.Text;
using System.Runtime.InteropServices;
namespace ROR {
    public static class DetachedImage {
        [DllImport("kernel32.dll", SetLastError=true)]
        static extern IntPtr OpenProcess(uint access, bool inherit, int id);
        [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
        static extern bool QueryFullProcessImageNameW(IntPtr handle, uint flags, StringBuilder path, ref uint size);
        [DllImport("kernel32.dll")]
        static extern bool CloseHandle(IntPtr handle);
        public static string Read(int id) {
            IntPtr handle = OpenProcess(0x1000, false, id);
            if (handle == IntPtr.Zero) return "";
            try {
                foreach (uint flags in new uint[] { 0, 1 }) {
                    StringBuilder path = new StringBuilder(32768);
                    uint size = (uint)path.Capacity;
                    if (QueryFullProcessImageNameW(handle, flags, path, ref size)) return path.ToString();
                }
                return "";
            } finally { CloseHandle(handle); }
        }
    }
}
"@ -ErrorAction Stop
    }
    return [ROR.DetachedImage]::Read($ProcessId)
}

function Get-DetachedDriveProcessAlerts {
    # Observations only: this check must never emit WARNING/FAILURE or establish cheating.
    $alerts = New-Object System.Collections.Generic.List[string]
    $unreadable = 0
    try {
        $processes = @(Get-CimInstance Win32_Process -ErrorAction Stop)
        $drives = @{}
        foreach ($drive in @(Get-CimInstance Win32_LogicalDisk -ErrorAction Stop)) {
            $drives[[string]$drive.DeviceID] = $drive
        }
    } catch {
        return 'INFO: Detached-drive process check inconclusive: process or drive enumeration failed.'
    }
    foreach ($process in $processes) {
        if ([int]$process.ProcessId -in @(0, 4)) { continue }
        $path = [string]$process.ExecutablePath
        if (-not $path) {
            try { $path = Get-DetachedProcessImagePath -ProcessId ([int]$process.ProcessId) } catch { $path = '' }
        }
        if (-not $path) { $unreadable++; continue }
        if ($path.StartsWith('\\?\')) { $path = $path.Substring(4) }
        $identity = "$($process.Name) (PID $($process.ProcessId), started $($process.CreationDate))"
        if ($path -match '^[A-Za-z]:\\') {
            $root = $path.Substring(0, 2)
            if (-not $drives.ContainsKey($root)) {
                $alerts.Add("INFO: Running process image points to an absent drive; the drive is absent from this scan snapshot (removed media or an unmapped drive are possible). Observation only; not evidence of cheating: $identity -> $path")
                continue
            }
            if ([int]$drives[$root].DriveType -eq 2) {
                $alerts.Add("INFO: Running process image is on a currently removable drive. Observation only; not evidence of cheating: $identity -> $path")
            }
            try {
                $item = Get-Item -LiteralPath $path -Force -ErrorAction Stop
                if ($item.PSIsContainer) {
                    $alerts.Add("INFO: Running process image path now resolves to a directory. Observation only; not evidence of cheating: $identity -> $path")
                }
            } catch [System.Management.Automation.ItemNotFoundException] {
                $alerts.Add("INFO: Process image file was not found at inspection time; deletion, software updates, or removed media are possible. Observation only; not evidence of cheating: $identity -> $path")
            } catch {
                $alerts.Add("INFO: Process image file could not be inspected; access or I/O error. File absence and drive removal are NOT established: $identity -> $path")
            }
        } elseif ($path -match '^\\Device\\HarddiskVolume') {
            $alerts.Add("INFO: Process image returned only a native volume path; drive availability could not be verified. Observation only; not evidence of cheating: $identity -> $path")
        } else {
            $unreadable++
        }
    }
    if ($unreadable -gt 0) {
        $alerts.Add("INFO: Detached-drive process check incomplete: $unreadable process image paths could not be inspected (permissions, process exit, or unsupported path).")
    }
    if ($alerts.Count -eq 0) {
        $alerts.Add('SUCCESS: No removable-drive or unavailable-image indicators found in inspected running processes; this does not rule out cheating or prior USB execution.')
    }
    return $alerts.ToArray()
}

function Get-UnsignedUserProgramAlerts {
    $alerts = @()
    try {
        $procs = Get-CimInstance Win32_Process -ErrorAction Stop
        $grouped = @{}
        foreach ($p in $procs) {
            $path = [string]$p.ExecutablePath
            if (-not (Test-UntrustedUserProgramPath -Path $path)) { continue }
            $sigInfo = Get-FileSignatureAssessment -Path $path
            if ($sigInfo.IsSigned) { continue }
            if (-not $grouped.ContainsKey($path)) {
                $grouped[$path] = @{
                    Name         = $p.Name
                    Status       = $sigInfo.Status
                    IsSelfSigned = $sigInfo.IsSelfSigned
                    Signer       = $sigInfo.Signer
                    Pids         = New-Object System.Collections.Generic.List[int]
                }
            }
            $grouped[$path].Pids.Add([int]$p.ProcessId)
        }

        foreach ($path in $grouped.Keys) {
            $item = $grouped[$path]
            $kw = Get-MatchedCheatKeyword -Text $path
            $kwTag = if ($kw) { " [$kw]" } else { '' }
            $pidStr = if ($item.Pids.Count -eq 1) { "PID $($item.Pids[0])" } else { "PID $($item.Pids -join ', ')" }
            if ($item.IsSelfSigned) {
                $alerts += "FAILURE: Program signed with SELF-SIGNED certificate running from user folder -> $($item.Name) ($pidStr) [Signer: $($item.Signer)] $path"
            } elseif ($kw) {
                $alerts += "FAILURE: Unsigned program$kwTag running from user folder ($($item.Status)) -> $($item.Name) ($pidStr) $path"
            } else {
                $alerts += "WARNING: Unsigned program running from user folder ($($item.Status)) -> $($item.Name) ($pidStr) $path"
            }
        }
    } catch { $alerts += 'WARNING: Could not enumerate processes for signature check' }
    if ($alerts.Count -eq 0) { $alerts += 'SUCCESS: No unsigned programs running from user folders' }
    return @($alerts | Select-Object -Unique)
}


public static string CheckHardwareBreakpoints() {
    try {
        int ctxSize = 1232;
        IntPtr pCtx = Marshal.AllocHGlobal(ctxSize);
        try {
            for (int i = 0; i < ctxSize; i += 4) Marshal.WriteInt32(pCtx, i, 0);
            Marshal.WriteInt32(pCtx, 0x30, 0x100010);
            IntPtr hT = GetCurrentThread();
            if (GetThreadContext(hT, pCtx)) {
                ulong dr0 = (ulong)Marshal.ReadInt64(pCtx, 0x48);
                ulong dr1 = (ulong)Marshal.ReadInt64(pCtx, 0x50);
                ulong dr2 = (ulong)Marshal.ReadInt64(pCtx, 0x58);
                ulong dr3 = (ulong)Marshal.ReadInt64(pCtx, 0x60);
                ulong dr6 = (ulong)Marshal.ReadInt64(pCtx, 0x68);
                ulong dr7 = (ulong)Marshal.ReadInt64(pCtx, 0x70);
                if (dr0 != 0 || dr1 != 0 || dr2 != 0 || dr3 != 0 || (dr7 & 0xFF) != 0) {
                    Marshal.WriteInt64(pCtx, 0x48, 0);
                    Marshal.WriteInt64(pCtx, 0x50, 0);
                    Marshal.WriteInt64(pCtx, 0x58, 0);
                    Marshal.WriteInt64(pCtx, 0x60, 0);
                    Marshal.WriteInt64(pCtx, 0x70, 0);
                    return "DR0=0x" + dr0.ToString("X") + ", DR1=0x" + dr1.ToString("X") + ", DR2=0x" + dr2.ToString("X") + ", DR3=0x" + dr3.ToString("X") + ", DR7=0x" + dr7.ToString("X");
                }
            }
        } finally {
            Marshal.FreeHGlobal(pCtx);
        }
    } catch {}
    return null;
}

public static string ScanNtdllTextSectionIntegrity() {
    try {
        IntPtr hNtdll = GetModuleHandle("ntdll.dll");
        if (hNtdll == IntPtr.Zero) return null;
        string sysNtdll = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), "ntdll.dll");
        if (!File.Exists(sysNtdll)) return null;

        byte[] diskBytes = File.ReadAllBytes(sysNtdll);
        int peOff = BitConverter.ToInt32(diskBytes, 0x3C);
        short numSections = BitConverter.ToInt16(diskBytes, peOff + 6);
        short optHdrSize = BitConverter.ToInt16(diskBytes, peOff + 20);
        int secStart = peOff + 24 + optHdrSize;

        for (int i = 0; i < numSections; i++) {
            int secOff = secStart + (i * 40);
            string secName = Encoding.ASCII.GetString(diskBytes, secOff, 8).TrimEnd('\0');
            if (secName.Equals(".text", StringComparison.OrdinalIgnoreCase)) {
                uint virtSize = BitConverter.ToUInt32(diskBytes, secOff + 8);
                uint virtAddr = BitConverter.ToUInt32(diskBytes, secOff + 12);
                uint rawSize = BitConverter.ToUInt32(diskBytes, secOff + 16);
                uint rawPtr = BitConverter.ToUInt32(diskBytes, secOff + 20);

                uint compareLen = Math.Min(virtSize, rawSize);
                IntPtr pMemText = new IntPtr(hNtdll.ToInt64() + virtAddr);

                int mismatchedBytes = 0;
                long firstDiffRva = 0;
                byte[] memChunk = new byte[4096];

                for (uint offset = 0; offset < compareLen; offset += 4096) {
                    uint chunkSize = Math.Min(4096U, compareLen - offset);
                    Marshal.Copy(new IntPtr(pMemText.ToInt64() + offset), memChunk, 0, (int)chunkSize);
                    for (int j = 0; j < (int)chunkSize; j++) {
                        byte diskB = diskBytes[rawPtr + offset + j];
                        byte memB = memChunk[j];
                        if (diskB != memB) {
                            if (mismatchedBytes == 0) firstDiffRva = virtAddr + offset + j;
                            mismatchedBytes++;
                        }
                    }
                }

                if (mismatchedBytes > 0) {
                    return string.Format("{0} modified byte(s) in ntdll.dll .text section (First hook at RVA +0x{1:X})", mismatchedBytes, firstDiffRva);
                }
                break;
            }
        }
    } catch {}
    return null;
}


private static List<string> _overlayHits;
private static bool OverlayEnumCallback(IntPtr hWnd, IntPtr lParam) {
    bool vis = IsWindowVisible(hWnd);
    int exStyle = GetWindowLong(hWnd, GWL_EXSTYLE);
    uint aff = 0;
    if (GetWindowDisplayAffinity(hWnd, out aff) && aff != 0) {
        uint wdaPid = 0;
        GetWindowThreadProcessId(hWnd, out wdaPid);
        StringBuilder wdaTitle = new StringBuilder(256);
        GetWindowTextW(hWnd, wdaTitle, wdaTitle.Capacity);
        _overlayHits.Add("WDA|" + wdaPid.ToString() + "|" + aff.ToString("X") + "|" + (vis ? "Visible" : "Hidden") + "|" + wdaTitle.ToString());
    }
    if (!vis) return true;
    if ((exStyle & (WS_EX_TRANSPARENT | WS_EX_LAYERED)) != 0) {
        uint pid = 0;
        GetWindowThreadProcessId(hWnd, out pid);
        StringBuilder title = new StringBuilder(256);
        GetWindowTextW(hWnd, title, title.Capacity);
        _overlayHits.Add(pid.ToString() + "|" + exStyle.ToString("X") + "|" + title.ToString());
    }
    return true;
}

public static string[] FindTopmostOverlays() {
    _overlayHits = new List<string>();
    try {
        EnumWindows(new EnumWindowsProc(OverlayEnumCallback), IntPtr.Zero);
        IntPtr hDesk = GetDesktopWindow();
        if (hDesk != IntPtr.Zero) {
            try { EnumChildWindows(hDesk, new EnumWindowsProc(OverlayEnumCallback), IntPtr.Zero); } catch {}
        }
    } catch {
        return null;
    }
    return new List<string>(new HashSet<string>(_overlayHits)).ToArray();
}


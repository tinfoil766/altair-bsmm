}

function Convert-RegistryFileTime {
    param($Raw)
    try {
        if ($Raw -is [byte[]] -and $Raw.Length -ge 8) { return [DateTime]::FromFileTime([BitConverter]::ToInt64($Raw, 0)) }
        if ($Raw -is [int64]) { return [DateTime]::FromFileTime($Raw) }
    } catch {}
    return $null
}

function Format-UsbRemovalObservation {
    param($Record, [datetime]$Logon)
    $stamp = ([datetime]$Record.Time).ToString('yyyy-MM-dd HH:mm:ss zzz', [Globalization.CultureInfo]::InvariantCulture)
    $kind = if ($Record.IsStorage) { 'USB storage device' } else { 'USB device' }
    $session = if ($Record.Time -ge $Logon) { 'since logon' } else { 'before current logon' }
    return "INFO: $kind last recorded removal: $stamp (PC local time; $session) -> $($Record.Name) [Device instance: $($Record.Id); source: Windows device LastRemovalDate]. Historical observation only; not proof of physical unplugging or cheating."
}

function Get-UsbHistoryAlerts {
    $alerts = @()
    $logon = Get-LogonTime
    $removed = @()

    $robloxProcs = @(Get-Process -Name 'RobloxPlayerBeta' -ErrorAction SilentlyContinue)
    $robloxStartTime = if ($robloxProcs.Count -gt 0) {
        try { ($robloxProcs | Sort-Object StartTime | Select-Object -First 1).StartTime } catch { $null }
    } else { $null }

    # 1. Unplugged USB Storage Drives from system device history (MountedDevices)
    $unpluggedDrives = Get-UnpluggedUsbDrives
    foreach ($uDrv in $unpluggedDrives.Keys) {
        $uObj = $unpluggedDrives[$uDrv]
        $devName = $uObj.Device
        $alerts += "INFO: USB storage drive history: $uDrv ($devName). Removal time unknown for this drive-letter record; do not infer it from executable timestamps."
    }
    $payloadTraces = Get-UsbPayloadTraces
    foreach ($pt in $payloadTraces) {
        $devStr = if ($pt.Device) { " [$($pt.Device)]" } else { "" }
        $alerts += "FAILURE: Injected payload '$($pt.FileName)' selected from UNPLUGGED USB drive ($($pt.FullPath)$devStr)"
    }

    $propKey = 'Properties\{83da6326-97a6-4088-9453-a1923f573b29}'
    foreach ($enumRoot in @('SYSTEM\CurrentControlSet\Enum\USBSTOR', 'SYSTEM\CurrentControlSet\Enum\USB')) {
        try {
            $root = Open-LocalMachineRegistryKey -SubKeyPath $enumRoot
            if (-not $root) { continue }
            $isStorage = ($enumRoot -like '*\USBSTOR')
            foreach ($dev in $root.GetSubKeyNames()) {
                if ($enumRoot -like '*\USB' -and $dev -match '(?i)ROOT_HUB|VID_8087|VID_045E&PID_0[0-9A-F]{3}$') { continue }
                $devKey = $root.OpenSubKey($dev)
                if (-not $devKey) { continue }
                foreach ($inst in $devKey.GetSubKeyNames()) {
                    $instKey = $devKey.OpenSubKey($inst)
                    if (-not $instKey) { continue }
                    try {
                        $removalKey = $instKey.OpenSubKey("$propKey\0067")
                        if ($removalKey) {
                            $removedAt = Convert-RegistryFileTime -Raw ($removalKey.GetValue(''))
                            $removalKey.Close()
                            if ($removedAt -and $removedAt.Year -gt 1601 -and $removedAt -le (Get-Date)) {
                                $name = [string]$instKey.GetValue('FriendlyName')
                                if (-not $name) { $name = ([string]$instKey.GetValue('DeviceDesc')) -replace '^@.*;', '' }
                                if (-not $name) { $name = $dev }
                                $removed += [pscustomobject]@{ Name = $name; Time = $removedAt; Id = "$dev\$inst"; IsStorage = $isStorage }
                            }
                        }
                    } catch {}
                    $instKey.Close()
                }
                $devKey.Close()
            }
            $root.Close()
        } catch {}
    }

    try {
        $twoWeeksAgo = (Get-Date).AddDays(-14)
        foreach ($b in @(Get-BamEntries | Where-Object { $_.Time -and ($_.Time -ge $logon -or $_.Time -ge $twoWeeksAgo) })) {
            $isWindowsSetup = ($b.Raw -match '(?i)\\(\$windows\.~bt|sources|windows\\servicing|windows\\system32)\\' -or $b.Leaf -in @('setup.exe', 'tiworker.exe', 'trustedinstaller.exe', 'dismhost.exe', 'msiexec.exe'))
            if ($isWindowsSetup) { continue }

            $kw = Get-MatchedCheatKeyword -Text "$($b.Leaf) $($b.Raw)"
            $rbxActive = [bool]($robloxStartTime -and $b.Time -ge $robloxStartTime)
            $rbxTag = if ($rbxActive) { ' [WHILE ROBLOX WAS ACTIVE]' } else { '' }

            $knownInstallers = 'discordsetup|steamtournament|steamsetup|spotifysetup|geforce|nvidia|logitech|razer|chromesetup|firefoxsetup|vcredist|directx'
            $isKnownInstaller = ($b.Leaf -match "(?i)^($knownInstallers)")

            if ($b.UnmountedVolume) {
                if ($isKnownInstaller) {
                    $alerts += "INFO: Installer '$($b.Leaf)' executed from unmounted volume$($b.DiskDesc) ($(Get-Date $b.Time -Format 'yyyy-MM-dd HH:mm:ss'))"
                } else {
                    $alerts += "FAILURE: Program '$($b.Leaf)' executed from UNPLUGGED USB / unmounted volume$($b.DiskDesc)$rbxTag ($(Get-Date $b.Time -Format 'yyyy-MM-dd HH:mm:ss')) -> $($b.Raw)"
                }
            } elseif ($b.RemovableDrive) {
                if ($isKnownInstaller) {
                    $alerts += "INFO: Installer '$($b.Leaf)' executed from removable USB drive$($b.DiskDesc) ($(Get-Date $b.Time -Format 'yyyy-MM-dd HH:mm:ss'))"
                } else {
                    $alerts += "FAILURE: Program '$($b.Leaf)' executed from removable USB drive$($b.DiskDesc)$rbxTag ($(Get-Date $b.Time -Format 'yyyy-MM-dd HH:mm:ss')) -> $($b.Path)"
                }
            }
        }
    } catch {}

    try {
        foreach ($lnkAlert in @(Get-UsbLnkVolumeHits)) {
            $alerts += $lnkAlert
        }
    } catch {}

    # 4. Windows Prefetch — detects executables launched from Unplugged USB / unmounted volumes
    try {
        $pfDir = "$env:WINDIR\Prefetch"
        if (Test-Path -LiteralPath $pfDir) {
            $pfList = @(Get-ChildItem -LiteralPath $pfDir -Filter '*.pf' -File -ErrorAction SilentlyContinue |
                Where-Object { $_.LastWriteTime -ge (Get-Date).AddDays(-14) })
            foreach ($pf in $pfList) {
                try {
                    $pfBytes = [System.IO.File]::ReadAllBytes($pf.FullName)
                    $pfText = [System.Text.Encoding]::Unicode.GetString($pfBytes)
                    foreach ($m in [regex]::Matches($pfText, '(?i)\\DEVICE\\HARDDISKVOLUME(\d+)')) {
                        $volKey = $m.Value.ToLowerInvariant()
                        $vMap = Get-MountedVolumeMap
                        if (-not $vMap.ContainsKey($volKey)) {
                            $exeLeaf = $pf.Name -replace '-[0-9A-Fa-f]{8}\.pf$', ''
                            $exeLeaf = $exeLeaf.ToLowerInvariant() + '.exe'
                            $alerts += "FAILURE: Program '$exeLeaf' executed from UNPLUGGED USB / unmounted volume [$($m.Value)] [Windows Prefetch: $($pf.Name)]"
                            break
                        }
                    }
                } catch {}
            }
        }
    } catch {}

    # 5. Windows RecentDocs MRU — catches .exe and .dll opened or accessed from USB
    try {
        $rdRoot = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\RecentDocs'
        if (Test-Path $rdRoot) {
            foreach ($extKey in @('', '.exe', '.dll', '.cfg')) {
                $targetKey = if ($extKey) { "$rdRoot\$extKey" } else { $rdRoot }
                if (-not (Test-Path $targetKey)) { continue }
                $rdProps = Get-ItemProperty -LiteralPath $targetKey -ErrorAction SilentlyContinue
                if (-not $rdProps) { continue }
                foreach ($rp in $rdProps.PSObject.Properties) {
                    if ($rp.Name -match '^\d+$' -and $rp.Value -is [byte[]]) {
                        $comb = ([System.Text.Encoding]::Unicode.GetString($rp.Value)) + ' ' + ([System.Text.Encoding]::ASCII.GetString($rp.Value))
                        foreach ($m in [regex]::Matches($comb, '(?i)\b([A-Za-z0-9_\-\. ]{2,60}\.(exe|dll|cfg))\b')) {
                            $fn = $m.Groups[1].Value.Trim()
                            $kw = Get-MatchedCheatKeyword -Text $fn
                            if ($kw -or $fn -match '(?i)(inject|clarity|overlay|cheat|esp|aim|loader|bypass|hook)') {
                                $alerts += "FAILURE: Cheat executable/DLL recently accessed via Windows Explorer [RecentDocs]: $fn"
                            }
                        }
                    }
                }
            }
        }
    } catch {}

    try {
        if ('ROR.FastEntropy' -as [type]) {
            $twoWeeksAgo = (Get-Date).AddDays(-14)
            $usnAlerts = @()
            foreach ($uHit in @([ROR.FastEntropy]::GetUsnBinaryAlerts())) {
                $parts = $uHit -split '\|', 5
                if ($parts.Count -ge 5) {
                    $uType = $parts[0]
                    $uAct  = $parts[1]
                    $uDisk = $parts[2]
                    $uPath = $parts[3]
                    $uRawTime = try { New-Object DateTime([int64]$parts[4]) } catch { $null }
                    if ($uRawTime -and $uRawTime -lt $twoWeeksAgo) { continue }
                    $uTime = if ($uRawTime) {
                        if ($uRawTime.Date -eq (Get-Date).Date) { $uRawTime.ToString('HH:mm:ss') }
                        else { $uRawTime.ToString('yyyy-MM-dd HH:mm:ss') }
                    } else { 'past 2 weeks' }
                    $rbxTag = if ($robloxStartTime -and $uRawTime -and $uRawTime -ge $robloxStartTime) { ' [WHILE ROBLOX WAS ACTIVE]' } else { '' }
                    if ($uType -eq 'PREFETCH_DEL') {
                        $usnAlerts += "FAILURE: USN Journal (JournalTrace) caught $uAct Prefetch trace ($uTime)$rbxTag on Disk [$uDisk] -> $uPath"
                    } else {
                        $usnAlerts += "WARNING: USN Journal (JournalTrace) caught $uAct binary ($uTime)$rbxTag on Disk [$uDisk] -> $uPath"
                    }
                }
            }
            if ($usnAlerts.Count -gt 25) {
                $alerts += @($usnAlerts | Select-Object -First 25)
                $alerts += "INFO: ... and $($usnAlerts.Count - 25) more USN journal deletion traces within the past 2 weeks"
            } else {
                $alerts += $usnAlerts
            }
        }
    } catch {}

    foreach ($r in ($removed | Sort-Object Time -Descending | Select-Object -First 15)) {
        $alerts += Format-UsbRemovalObservation -Record $r -Logon $logon
    }
    if ($removed.Count -gt 15) { $alerts += "INFO: Showing the 15 most recent device removal records; $($removed.Count - 15) additional records omitted." }
    if ($removed.Count -eq 0) {
        $alerts += 'INFO: USB removal date/time unavailable: no readable, valid last-removal timestamp found. This does not establish that no USB was unplugged.'
    }
    return @($alerts | Select-Object -Unique)
}


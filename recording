function Get-KeyAuthAlerts {
    param([switch]$Quick)

    $alerts = @()
    try {
        # 1. KeyAuth Known Endpoints & IPs
        $keyAuthIps = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
        foreach ($kip in @(
            '104.26.1.5', '104.26.0.5', '172.67.72.57', '104.21.5.124', '172.67.133.114',
            '172.67.217.102', '104.21.86.91', '188.114.96.4', '188.114.97.4', '45.133.74.121',
            '15.197.148.33', '3.33.130.190'
        )) {
            [void]$keyAuthIps.Add($kip)
        }

        # 2. Check Hosts File for KeyAuth Blocking / Redirection
        try {
            $hostsPath = Join-Path $env:SystemRoot 'System32\drivers\etc\hosts'
            if (Test-Path -LiteralPath $hostsPath) {
                $lines = Get-Content -LiteralPath $hostsPath -ErrorAction SilentlyContinue
                foreach ($line in $lines) {
                    $trimmed = $line.Trim()
                    if ($trimmed.StartsWith('#') -or -not $trimmed) { continue }
                    if ($trimmed -match '(?i)\b(keyauth|api\.keyauth)\b') {
                        $alerts += "FAILURE: KeyAuth signal is BLOCKED/REDIRECTED in hosts file -> $trimmed"
                    }
                }
            }
        } catch {}

        # 3. Check Windows Firewall for Outbound Rules Blocking KeyAuth
        try {
            $fwRules = Get-NetFirewallRule -Direction Outbound -Action Block -Enabled True -ErrorAction SilentlyContinue
            foreach ($r in $fwRules) {
                if ($r.DisplayName -match '(?i)\bkeyauth\b' -or $r.Name -match '(?i)\bkeyauth\b' -or $r.Description -match '(?i)\bkeyauth\b') {
                    $alerts += "FAILURE: Windows Firewall rule is BLOCKING KeyAuth signal -> $($r.DisplayName)"
                }
            }
        } catch {}

        # 4. Active Signal Reachability & Blocking Probe
        try {
            $probeSuccess = $false
            foreach ($targetIp in @('104.26.0.5', '104.21.5.124')) {
                try {
                    $tcp = New-Object System.Net.Sockets.TcpClient
                    $iar = $tcp.BeginConnect($targetIp, 443, $null, $null)
                    if ($iar.AsyncWaitHandle.WaitOne(1500) -and $tcp.Connected) {
                        $tcp.EndConnect($iar)
                        $probeSuccess = $true
                        $tcp.Close()
                        break
                    }
                    $tcp.Close()
                } catch {}
            }

            if (-not $probeSuccess) {
                $internetAlive = $false
                try {
                    $testClient = New-Object System.Net.Sockets.TcpClient
                    $iarTest = $testClient.BeginConnect('1.1.1.1', 53, $null, $null)
                    if ($iarTest.AsyncWaitHandle.WaitOne(1000) -and $testClient.Connected) {
                        $testClient.EndConnect($iarTest)
                        $internetAlive = $true
                    }
                    $testClient.Close()
                } catch {}

                if ($internetAlive) {
                    $alerts += "FAILURE: KeyAuth signal is actively BLOCKED -> Internet is connected, but traffic to KeyAuth (port 443) is blocked/dropped"
                }
            }
        } catch {}

        # 5. DNS Cache (Websites & APIs resolved by apps/browsers)
        try {
            $dnsEntries = @(Get-DnsClientCache -ErrorAction SilentlyContinue | Where-Object { $_.Entry -like '*keyauth*' })
            foreach ($de in $dnsEntries) {
                $entry = [string]$de.Entry
                $data = [string]$de.Data
                if ($data -match '^(127\.|0\.0\.0\.0|::1)') {
                    $alerts += "FAILURE: KeyAuth DNS signal is BLOCKED / SINKHOLED to loopback -> $entry resolves to $data"
                } else {
                    $alerts += "FAILURE: KeyAuth domain in DNS cache -> $entry" + ($(if ($data) { " (Resolved: $data)" } else { "" }))
                    if ($data -and $data -match '^\d{1,3}(\.\d{1,3}){3}$') {
                        [void]$keyAuthIps.Add($data)
                    }
                }
            }
        } catch {}

        # 6. Live TCP Connections (Executables connecting to KeyAuth)
        try {
            $conns = @(Get-NetTCPConnection -State Established,SynSent,TimeWait,CloseWait -ErrorAction SilentlyContinue)
            if ($conns.Count -gt 0 -and $keyAuthIps.Count -gt 0) {
                $procMap = @{}
                try {
                    Get-CimInstance Win32_Process -Property ProcessId, Name, ExecutablePath -ErrorAction SilentlyContinue | ForEach-Object {
                        $procMap[[int]$_.ProcessId] = @{ Name = $_.Name; Path = $_.ExecutablePath }
                    }
                } catch {}

                $browserNames = @('chrome.exe', 'msedge.exe', 'firefox.exe', 'brave.exe', 'opera.exe', 'vivaldi.exe')

                foreach ($c in $conns) {
                    $remIp = [string]$c.RemoteAddress
                    if ($keyAuthIps.Contains($remIp)) {
                        $pidNum = [int]$c.OwningProcess
                        if ($pidNum -eq 0 -or $pidNum -eq $PID) { continue }
                        $pInfo = $procMap[$pidNum]
                        $pName = if ($pInfo -and $pInfo.Name) { $pInfo.Name } else { "PID $pidNum" }
                        $pPath = if ($pInfo -and $pInfo.Path) { $pInfo.Path } else { "Unknown path" }

                        if ($browserNames -contains $pName.ToLower()) {
                            $alerts += "FAILURE: Browser connected to KeyAuth website -> $pName (PID $pidNum) to " + $remIp + ":$($c.RemotePort)"
                        } else {
                            $alerts += "FAILURE: Executable connected to KeyAuth API -> '$pName' (PID $pidNum, Path: $pPath) to " + $remIp + ":$($c.RemotePort)"
                        }
                    }
                }
            }
        } catch {}

        # 7. Running Executables & Modules (KeyAuth binary inspection)
        try {
            $keySignatures = @(
                'api.keyauth.win', 'keyauth.win/api', 'keyauth.cc/api', 'api.keyauth.cc',
                'keyauth.uk/api', 'keyauth.online/api',
                'KeyAuth::api', 'KeyAuthApp.', 'KeyAuth.dll', 'init_keyauth',
                'keyauth_secret', 'keyauth_ownerid', 'KeyAuthApp'
            )

            $procList = @(Get-CimInstance Win32_Process -Property ProcessId, Name, ExecutablePath -ErrorAction SilentlyContinue)
            $uniqueExes = @{}
            foreach ($proc in $procList) {
                $ep = [string]$proc.ExecutablePath
                if (-not $ep) { continue }
                $epLower = $ep.ToLower()
                if ($epLower.StartsWith("$($env:SystemRoot.ToLower())\") -or
                    $epLower.StartsWith("$($env:ProgramFiles.ToLower())\") -or
                    (${env:ProgramFiles(x86)} -and $epLower.StartsWith("${env:ProgramFiles(x86)}\".ToLower()))) {
                    continue
                }
                if (-not $uniqueExes.ContainsKey($ep)) {
                    $uniqueExes[$ep] = [System.Collections.Generic.List[PSCustomObject]]::new()
                }
                $uniqueExes[$ep].Add($proc)
            }

            foreach ($exePath in $uniqueExes.Keys) {
                if (-not (Test-Path -LiteralPath $exePath -ErrorAction SilentlyContinue)) { continue }
                try {
                    $fi = Get-Item -LiteralPath $exePath -ErrorAction SilentlyContinue
                    if (-not $fi -or $fi.Length -eq 0) { continue }

                    $scanSize = [Math]::Min($fi.Length, 2097152)
                    $fs = [System.IO.FileStream]::new($exePath, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
                    $buf = New-Object byte[] $scanSize
                    $readBytes = $fs.Read($buf, 0, $scanSize)
                    $fs.Close()

                    $asciiStr = [System.Text.Encoding]::ASCII.GetString($buf, 0, $readBytes)
                    $unicodeStr = [System.Text.Encoding]::Unicode.GetString($buf, 0, $readBytes)

                    foreach ($sig in $keySignatures) {
                        if ($asciiStr.IndexOf($sig, [System.StringComparison]::OrdinalIgnoreCase) -ge 0 -or
                            $unicodeStr.IndexOf($sig, [System.StringComparison]::OrdinalIgnoreCase) -ge 0) {
                            $instances = $uniqueExes[$exePath]
                            $procNames = ($instances | ForEach-Object { "$($_.Name) (PID $($_.ProcessId))" }) -join ', '
                            $alerts += "FAILURE: Executable contains KeyAuth integration -> $procNames (Path: $exePath) [Signature: $sig]"
                            break
                        }
                    }
                } catch {}
            }
        } catch {}

        # 8. Filesystem & Registry KeyAuth Markers
        try {
            $fsRoots = @(
                (Join-Path $env:ProgramData 'KeyAuth'),
                (Join-Path $env:LOCALAPPDATA 'KeyAuth'),
                (Join-Path $env:APPDATA 'KeyAuth')
            )
            foreach ($fRoot in $fsRoots) {
                if (Test-Path -LiteralPath $fRoot) {
                    $alerts += "FAILURE: KeyAuth directory found -> $fRoot"
                    Get-ChildItem -LiteralPath $fRoot -Recurse -File -Depth 2 -ErrorAction SilentlyContinue | ForEach-Object {
                        $alerts += "FAILURE: KeyAuth file -> $($_.FullName)"
                    }
                }
            }

            $regPaths = @(
                'HKCU:\Software\KeyAuth',
                'HKLM:\SOFTWARE\KeyAuth',
                'HKLM:\SOFTWARE\WOW6432Node\KeyAuth'
            )
            foreach ($rp in $regPaths) {
                if (Test-Path -LiteralPath $rp) {
                    $alerts += "FAILURE: KeyAuth registry key found -> $rp"
                }
            }
        } catch {}

        # 9. Browser History (Skipped in Quick mode during match monitor)
        if (-not $Quick) {
            try {
                $browserPatterns = @(
                    @{ Browser = 'Google Chrome'; Pattern = "$env:LOCALAPPDATA\Google\Chrome\User Data\*\History" },
                    @{ Browser = 'Chrome SxS';    Pattern = "$env:LOCALAPPDATA\Google\Chrome SxS\User Data\*\History" },
                    @{ Browser = 'Microsoft Edge';Pattern = "$env:LOCALAPPDATA\Microsoft\Edge\User Data\*\History" },
                    @{ Browser = 'Brave';         Pattern = "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data\*\History" },
                    @{ Browser = 'Opera';         Pattern = "$env:APPDATA\Opera Software\Opera Stable\History" },
                    @{ Browser = 'Opera GX';      Pattern = "$env:APPDATA\Opera Software\Opera GX Stable\History" },
                    @{ Browser = 'Vivaldi';       Pattern = "$env:LOCALAPPDATA\Vivaldi\User Data\*\History" },
                    @{ Browser = 'Firefox';       Pattern = "$env:APPDATA\Mozilla\Firefox\Profiles\*\places.sqlite" },
                    @{ Browser = 'Waterfox';      Pattern = "$env:APPDATA\Waterfox\Profiles\*\places.sqlite" },
                    @{ Browser = 'Floorp';        Pattern = "$env:APPDATA\Floorp\Profiles\*\places.sqlite" }
                )

                $urlRegex = [regex]'(?i)https?://[a-zA-Z0-9\.\-_]*keyauth\.(?:win|cc|uk|com|online|us|org|seller|io)(?:/[^\s\x00"'']*)?'
                $seenUrls = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)

                foreach ($bp in $browserPatterns) {
                    $historyFiles = @(Get-ChildItem -Path $bp.Pattern -File -ErrorAction SilentlyContinue)
                    foreach ($hf in $historyFiles) {
                        try {
                            $fs = [System.IO.FileStream]::new($hf.FullName, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite -bor [System.IO.FileShare]::Delete)
                            $sr = [System.IO.StreamReader]::new($fs, [System.Text.Encoding]::ASCII)
                            $buf = New-Object char[] 65536
                            $overlap = ""

                            while (($charsRead = $sr.Read($buf, 0, $buf.Length)) -gt 0) {
                                $chunk = $overlap + (New-Object string ($buf, 0, $charsRead))
                                $matches = $urlRegex.Matches($chunk)
                                foreach ($m in $matches) {
                                    $rawUrl = $m.Value
                                    if ($rawUrl -match '^(https?://[^\s]+?)(?:https?://|$)') {
                                        $rawUrl = $matches[1]
                                    }
                                    $cleanUrl = ($rawUrl -replace '[\x00-\x1F\x7F].*$', '').Trim().TrimEnd('/', '?', '&', ' ')
                                    if ($cleanUrl -and $seenUrls.Add($cleanUrl)) {
                                        $alerts += "FAILURE: Browser history records visit to KeyAuth website -> '$cleanUrl' in $($bp.Browser)"
                                    }
                                }
                                if ($charsRead -ge 200) {
                                    $overlap = $chunk.Substring($chunk.Length - 200)
                                } else {
                                    $overlap = ""
                                }
                            }
                            $sr.Close()
                            $fs.Close()
                        } catch {}
                    }
                }
            } catch {}
        }

        if ($alerts.Count -eq 0) {
            $alerts += 'SUCCESS: KeyAuth clean (Signal verified, no connections or blocked routes detected)'
        }
    } catch {
        $alerts += 'WARNING: KeyAuth check failed'
    }
    return @($alerts | Select-Object -Unique)
}

